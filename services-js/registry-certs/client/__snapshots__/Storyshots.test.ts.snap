  />,
  .emotion-1 {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.emotion-0 {
  color: #d22d23;
}

.emotion-6 {
  width: 100%;
  background: #e0e0e0;
  background: #f2f2f2;
  margin-bottom: 3.125rem;
}

.emotion-6 .drawerHeader {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  width: 100%;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
  -ms-flex-pack: justify;
  justify-content: space-between;
  -webkit-align-items: center;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
  padding: 12px 24px;
  cursor: pointer;
  border: 0;
  color: #1871bd;
  font-family: Lora;
  font-size: 20px;
  font-style: normal;
  font-weight: 700;
  line-height: normal;
  -webkit-text-decoration-style: solid;
  text-decoration-style: solid;
  -webkit-text-decoration-skip-ink: auto;
  text-decoration-skip-ink: auto;
  -webkit-text-decoration-thickness: auto;
  text-decoration-thickness: auto;
  text-underline-offset: -3px;
  text-underline-position: from-font;
}

.emotion-6 .drawerHeader .arrow {
  border: solid #1871bd;
  border-width: 0 2px 2px 0;
  display: inline-block;
  padding: 3px;
  margin-top: -3px;
  -webkit-transform: rotate(45deg);
  -ms-transform: rotate(45deg);
  transform: rotate(45deg);
  -webkit-transform: rotate(45deg);
}

.emotion-6 .drawerHeader [aria-expanded='true'] {
  border-color: white;
}

.emotion-6 .drawerHeader:hover,
.emotion-6 .drawerHeader:focus {
  color: #fff;
  -webkit-text-decoration: underline;
  text-decoration: underline;
  background: #1871bd;
  -webkit-text-decoration-line: underline;
  text-decoration-line: underline;
}

.emotion-6 .drawerHeader:hover .arrow,
.emotion-6 .drawerHeader:focus .arrow {
  border-color: #fff;
}

.emotion-6 .drawerHeader[aria-expanded='true'] {
  margin-bottom: 0;
  color: #fff;
  background: #091f2f;
}

.emotion-6 .drawerHeader[aria-expanded='true'] .arrow {
  margin-top: 6px;
  border-color: white;
  -webkit-transform: rotate(-135deg);
  -ms-transform: rotate(-135deg);
  transform: rotate(-135deg);
  -webkit-transform: rotate(-135deg);
}

.emotion-6 .body {
  color: #091f2f;
  font-family: Lora,Georgia,serif;
  font-size: 1.125em;
  font-style: normal;
  font-weight: 500;
  line-height: normal;
  padding: 0px 24px;
}

.emotion-6 .body .summary__qty {
  font-family: Lora,Georgia,serif;
  font-size: 1.125em;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid #d2d2d2;
}

.emotion-6 .body .order_items {
  margin-bottom: 1.5rem;
}

.emotion-6 .body .order_items--death {
  margin-bottom: 0;
}

.emotion-6 .body .cost_summary,
.emotion-6 .body .notes {
  padding-bottom: 1.115rem;
  font-style: normal;
}

.emotion-6 .drawerHeader[aria-expanded='true'] + .body {
  padding: 24px;
}

.emotion-6 .drawerHeader[aria-expanded='true'] + .body .order_items--death {
  margin-bottom: 2rem;
}

.emotion-6 .drawerHeader[aria-expanded='true'] + .body .cost_summary {
  padding-bottom: 2rem;
}

.emotion-6 .drawerHeader[aria-expanded='true'] + .body .notes {
  padding-bottom: 0;
}

.emotion-7 {
  margin-bottom: 3.5rem;
}

.emotion-7 legend {
  font-size: 24px;
  font-family: Montserrat,Arial,sans-serif;
  font-weight: 700;
  margin-bottom: 1.75rem;
}

.emotion-7 .txt-l,
.emotion-7 label.sel-l {
  font-size: 16px;
  font-family: Montserrat,Arial,sans-serif;
  font-weight: 700;
}

.emotion-7 .row {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
  -ms-flex-pack: justify;
  justify-content: space-between;
  -webkit-align-items: flex-start;
  -webkit-box-align: flex-start;
  -ms-flex-align: flex-start;
  align-items: flex-start;
  color: #091f2f;
  font-family: Lora,Georgia,serif;
}

.emotion-7 .row label.header {
  display: inline-block;
  color: #091f2f;
  font-family: Montserrat,Arial,sans-serif;
  font-size: 24px;
  font-style: normal;
  font-weight: 700;
  line-height: normal;
  text-transform: uppercase;
  margin-bottom: 0.25rem;
}

.emotion-7 .row .info {
  margin-bottom: 0.5rem;
}

.emotion-7 .row .btn {
  font-family: Lora,Georgia,serif;
  color: #1871bd;
  text-align: center;
  font-size: 16px;
  font-style: normal;
  font-weight: 400;
  line-height: normal;
  text-transform: capitalize;
  background: #fff;
  border: 1px solid #d2d2d2;
  padding: 13px;
}

.emotion-7 .row .btn:hover {
  background: #1871bd;
  color: #fff;
}

.emotion-3 progress {
  margin: 1rem 0 0.25rem;
  width: 100%;
  height: 1rem;
  border: 2px solid #091f2f;
  background-color: #fff;
}

.emotion-3 progress::-webkit-progress-bar {
  background-color: #fff;
}

.emotion-3 progress::-webkit-progress-value {
  -webkit-transition: width 0.5s;
  transition: width 0.5s;
  background-color: #288be4;
}

.emotion-3 progress::-moz-progress-bar {
  background-color: #288be4;
}

.emotion-3 progress::-ms-fill {
  background-color: #288be4;
}

.emotion-3 span {
  font-style: italic;
}

.emotion-8 {
  max-width: 45rem;
}

.emotion-2 {
  font-family: Montserrat,Arial,sans-serif;
  font-weight: 700;
  font-size: 2rem;
  line-height: 1.2;
  text-transform: uppercase;
  color: #091f2f;
  margin: 0 0 1.5rem;
}

.emotion-4 {
  margin-bottom: 2rem;
}

.emotion-5 {
  font-family: Montserrat,Arial,sans-serif;
  font-weight: 700;
  font-size: 1.875rem;
  line-height: 1.2;
  text-transform: uppercase;
  color: #091f2f;
  margin: 0 0 1.5rem;
}

