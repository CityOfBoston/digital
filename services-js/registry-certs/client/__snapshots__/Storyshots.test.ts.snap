  .emotion-1 {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.emotion-0 {
  color: #d22d23;
}

.emotion-2 progress {
  margin: 1rem 0 0.25rem;
  width: 100%;
  height: 1rem;
  border: 2px solid #091f2f;
  background-color: #fff;
}

.emotion-2 progress::-webkit-progress-bar {
  background-color: #fff;
}

.emotion-2 progress::-webkit-progress-value {
  -webkit-transition: width 0.5s;
  transition: width 0.5s;
  background-color: #288be4;
}

.emotion-2 progress::-moz-progress-bar {
  background-color: #288be4;
}

.emotion-2 progress::-ms-fill {
  background-color: #288be4;
}

.emotion-2 span {
  font-style: italic;
}

.emotion-3 {
  padding-bottom: 0.25rem;
  margin-bottom: 0;
  font-family: Montserrat,Arial,sans-serif;
  font-weight: 700;
  font-size: 1.5rem;
  color: #091f2f;
  text-transform: uppercase;
}

.emotion-3.secondary {
  margin-bottom: 1rem;
  font-size: 1.25rem;
  border-width: 3px;
}

.emotion-3.secondary em {
  font-size: 1rem;
}

.emotion-4 {
  font-weight: 700;
}

