                  Order Summary
                </h1>
                <div
                  className="emotion-6"
                >
                  <div
                    className="row"
                  >
                    <div
                      className="col"
                    >
                      Subtotal: 8 certificates × $14.00
                    </div>
                    <div
                      className="col"
                    >
                      $
                      112.00
                    </div>
                  </div>
                  
                  <div
                    className="row"
                  >
                    <div
                      className="col"
                    >
                      US Shipping
                    </div>
                    <div
                      className="col"
                    >
                      FREE
                    </div>
                  </div>
                  <div
                    className="row"
                  >
                    <div
                      className="col"
                    >
                      USPS Tracking®
                    </div>
                    <div
                      className="col"
                    >
                      $ 5.00
                    </div>
                  </div>
                  <div
                    className="row"
                  >
                    <div
                      className="col"
                    >
                      Service fee
                    </div>
                    <div
                      className="col"
                    >
                      $ 
                      2.77
                    </div>
                  </div>
                  <div
                    className="row"
                  >
                    <div
                      className="col"
                    >
                      Total
                    </div>
                    <div
                      className="col total-cost"
