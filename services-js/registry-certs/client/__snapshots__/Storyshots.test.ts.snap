  />,
  .emotion-1 {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.emotion-0 {
  color: #d22d23;
}

.emotion-2 {
  padding-bottom: 0.25rem;
  margin-bottom: 0;
  font-family: Montserrat,Arial,sans-serif;
  font-weight: 700;
  font-size: 1.5rem;
  color: #091f2f;
  text-transform: uppercase;
}

.emotion-2.secondary {
  margin-bottom: 1rem;
  font-size: 1.25rem;
  border-width: 3px;
}

.emotion-2.secondary em {
  font-size: 1rem;
}

.emotion-3 {
  width: 100%;
  background: #e0e0e0;
  background: #f2f2f2;
  margin-bottom: 3.125rem;
}

.emotion-3 .drawerHeader {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  width: 100%;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
  -ms-flex-pack: justify;
  justify-content: space-between;
  -webkit-align-items: center;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
  padding: 12px 24px;
  cursor: pointer;
  border: 0;
  color: #1871bd;
  font-family: Lora;
  font-size: 20px;
  font-style: normal;
  font-weight: 700;
  line-height: normal;
  -webkit-text-decoration-style: solid;
  text-decoration-style: solid;
  -webkit-text-decoration-skip-ink: auto;
  text-decoration-skip-ink: auto;
  -webkit-text-decoration-thickness: auto;
  text-decoration-thickness: auto;
  text-underline-offset: -3px;
  text-underline-position: from-font;
}

.emotion-3 .drawerHeader .arrow {
  border: solid #1871bd;
  border-width: 0 2px 2px 0;
  display: inline-block;
  padding: 3px;
  margin-top: -3px;
  -webkit-transform: rotate(45deg);
  -ms-transform: rotate(45deg);
  transform: rotate(45deg);
  -webkit-transform: rotate(45deg);
}

.emotion-3 .drawerHeader [aria-expanded='true'] {
  border-color: white;
}

.emotion-3 .drawerHeader:hover,
.emotion-3 .drawerHeader:focus {
  color: #fff;
  -webkit-text-decoration: underline;
  text-decoration: underline;
  background: #1871bd;
  -webkit-text-decoration-line: underline;
  text-decoration-line: underline;
}

.emotion-3 .drawerHeader:hover .arrow,
.emotion-3 .drawerHeader:focus .arrow {
  border-color: #fff;
}

.emotion-3 .drawerHeader[aria-expanded='true'] {
  margin-bottom: 0;
  color: #fff;
  background: #091f2f;
}

.emotion-3 .drawerHeader[aria-expanded='true'] .arrow {
  margin-top: 6px;
  border-color: white;
  -webkit-transform: rotate(-135deg);
  -ms-transform: rotate(-135deg);
  transform: rotate(-135deg);
  -webkit-transform: rotate(-135deg);
}

.emotion-3 .body {
  color: #091f2f;
  font-family: Lora,Georgia,serif;
  font-size: 1.125em;
  font-style: normal;
  font-weight: 500;
  line-height: normal;
  padding: 0px 24px;
}

.emotion-3 .body .summary__qty {
  font-family: Lora,Georgia,serif;
  font-size: 1.125em;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid #d2d2d2;
}

.emotion-3 .body .order_items {
  margin-bottom: 1.5rem;
}

.emotion-3 .body .order_items--death {
  margin-bottom: 0;
}

.emotion-3 .body .cost_summary,
.emotion-3 .body .notes {
  padding-bottom: 1.115rem;
  font-style: normal;
}

.emotion-3 .drawerHeader[aria-expanded='true'] + .body {
  padding: 24px;
}

.emotion-3 .drawerHeader[aria-expanded='true'] + .body .order_items--death {
  margin-bottom: 2rem;
}

.emotion-3 .drawerHeader[aria-expanded='true'] + .body .cost_summary {
  padding-bottom: 2rem;
}

.emotion-3 .drawerHeader[aria-expanded='true'] + .body .notes {
  padding-bottom: 0;
}

.emotion-4 {
  margin-bottom: 3.5rem;
}

.emotion-4 legend {
  font-size: 24px;
  font-family: Montserrat,Arial,sans-serif;
  font-weight: 700;
  margin-bottom: 1.75rem;
}

.emotion-4 .txt-l,
.emotion-4 label.sel-l {
  font-size: 16px;
  font-family: Montserrat,Arial,sans-serif;
  font-weight: 700;
}

