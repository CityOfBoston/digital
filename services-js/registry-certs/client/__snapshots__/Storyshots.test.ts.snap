      />
      <header
        className="h"
        dangerouslySetInnerHTML={
          Object {
            "__html": "
  <label for=\\"brg-tr\\" class=\\"brg-b\\">
    <div class=\\"brg\\">
      <span class=\\"brg-c\\">
        <span class=\\"brg-c-i\\"></span>
      </span>
      <span class=\\"brg-t\\"><span class=\\"a11y--h\\">Toggle </span>Menu</span>
