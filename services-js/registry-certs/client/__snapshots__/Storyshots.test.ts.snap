      <main
        className="b-ff"
      >
        <div
          aria-live="polite"
          className="b-c b-c--hsm b-c--nbp"
        >
          <section
            className="m-t500"
          >
            <h2
              className="emotion-2"
            >
              Review Order
            </h2>
            <div
              className="emotion-5"
            >
              <div
                className="t--info m-v500"
              >
                Your order is not yet complete. Please check the information below, then click the 
                <b>
                  Submit Order
                </b>
                 button.
              </div>
              <form
                acceptCharset="UTF-8"
                method="post"
                onSubmit={[Function]}
              >
                <div
                  className="row info-row"
                >
                  <div
                    className="col"
                  >
                    <label
                      className="header"
                    >
                      Contact Information
                    </label>
                    <div
                      className="info"
                    >
                      squirrel.girl@avengers.org
                    </div>
                    <div
                      className="info"
                    >
                      (555) 123-9999
                    </div>
                  </div>
                  <div
                    className="col"
                  >
                    <a
                      aria-label="Edit contact information"
                      className="btn"
                      href="/birth/checkout?page=shipping"
                      onClick={[Function]}
                      onMouseEnter={[Function]}
                    >
                      edit
                    </a>
                  </div>
                </div>
                <div
                  className="row info-row"
                >
                  <div
                    className="col"
                  >
                    <label
                      className="header"
                    >
                      Shipping Address
                    </label>
                    <div>
                      Doreen Green
                    </div>
                    <div>
                      Empire State University
                    </div>
                    <div>
                      Dorm Hall, Apt 5
                    </div>
                    <div>
                      10 College Avenue
                    </div>
                    <div>
                      New York, NY 12345
                    </div>
                  </div>
                  <div
                    className="col"
                  >
                    <a
                      aria-label="Edit contact information"
                      className="btn"
                      href="/birth/checkout?page=shipping"
                      onClick={[Function]}
                      onMouseEnter={[Function]}
                    >
                      edit
                    </a>
                  </div>
                </div>
                <div
                  className="row info-row"
                >
                  <div
                    className="col"
                  >
                    <label
                      className="header"
                    >
                      Payment Information
                    </label>
                    <div>
                      Nancy Whitehead
                    </div>
                    <div>
                      •••• •••• •••• 
                      4040
                    </div>
                    <div>
                      3 Avengers Towers
                    </div>
                    <div>
                      New York
                      , 
                      NY
                       
                      12223
                    </div>
                  </div>
                  <div
                    className="col"
                  >
                    <a
                      aria-label="Edit contact information"
                      className="btn"
                      href="/birth/checkout?page=payment"
                      onClick={[Function]}
                      onMouseEnter={[Function]}
                    >
                      edit
                    </a>
                  </div>
                </div>
                <div
                  className="row"
                >
                  <div
                    className="col"
                  >
                    <label
                      className="header"
                    >
                      Order Details
                    </label>
                  </div>
                  <div
                    className="col"
