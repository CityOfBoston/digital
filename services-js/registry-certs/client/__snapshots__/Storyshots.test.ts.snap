                      Doreen Green
                    </div>
                    <div>
                      Empire State University
                    </div>
                    <div>
                      Dorm Hall, Apt 5
                    </div>
                    <div>
                      10 College Avenue
                    </div>
                    <div>
                      New York, NY 12345
                    </div>
                  </div>
                  <div
                    className="col"
                  >
                    <a
                      aria-label="Edit contact information"
                      className="btn"
                      href="/marriage/checkout?page=shipping"
                      onClick={[Function]}
                      onMouseEnter={[Function]}
                    >
                      edit
                    </a>
                  </div>
                </div>
                <div
                  className="row info-row"
                >
                  <div
                    className="col"
                  >
                    <label
                      className="header"
                    >
