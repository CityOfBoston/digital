exports[`Storyshots Marriage Intention/Form Components Step 5. Review - Contact [Section] 1`] = `
.emotion-0 {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  overflow: hidden;
  -webkit-align-items: center;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
  -webkit-align-items: center;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
  -ms-flex-pack: justify;
  justify-content: space-between;
  margin: 1em 0;
  color: #fff;
}

.emotion-0 .wrapper-title h1,
.emotion-0 .wrapper-title h2 {
  color: #091f2f;
  font-size: 1.0rem;
  font-weight: 700;
  text-transform: uppercase;
  font-family: Montserrat,Arial,sans-serif;
  line-height: 1.875em;
}

.emotion-0 .wrapper-title h2 {
  font-size: 1.125rem;
}

.emotion-0 .wrapper-btn .btn {
  color: #091f2f;
  background: #fff;
  border: 2px solid #091f2f;
}

.emotion-0 .wrapper-btn .btn:hover {
  color: #fff;
  background: #1871bd;
}

@media screen and (min-width:480px) {
  .emotion-0 .wrapper-title {
    -webkit-box-flex: 1;
    -webkit-flex-grow: 1;
    -ms-flex-positive: 1;
    flex-grow: 1;
  }

  .emotion-0 .wrapper-title h1,
  .emotion-0 .wrapper-title h2 {
    color: #091f2f;
    font-size: 1.5625rem;
    line-height: 1.875em;
  }
}

@media screen and (max-width:480px) {
  .emotion-0 .wrapper-title h1 {
    line-height: 1.25em;
  }

  .emotion-0 .wrapper-btn .btn {
    font-size: 12px;
    padding: 1em;
  }
}

.emotion-1 .section-wrapper {
  font-size: 0.9375rem;
  font-family: Montserrat,Arial,sans-serif;
  margin-bottom: 2em;
}

.emotion-1 .section-wrapper h2 {
  color: #091f2f;
  font-size: 1.125rem;
  font-weight: bold;
  text-transform: uppercase;
  margin-bottom: 0.5em;
}

.emotion-1 .section-wrapper .field-value-pair {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  margin-bottom: 1em;
}

.emotion-1 .section-wrapper .field-value-pair label {
  font-weight: normal;
}

.emotion-1 .section-wrapper .field-value-pair .field {
  display: inline-block;
  width: 60%;
  color: #58585b;
  font-size: 0.9375rem;
  text-transform: uppercase;
}

.emotion-1 .section-wrapper .field-value-pair .value {
  display: inline-block;
  width: 40%;
  font-weight: normal;
}

<div>
  <div
    className="emotion-0"
  >
    <div
      className="wrapper-title"
    >
