                        </span>
                        No
                      </p>
                      <p>
                        <span
                          className="death-order-item-label"
                        >
                          Quantity: 
                        </span>
                        5
                      </p>
                    </div>
                    <div
                      className="death-order-item"
                    >
                      <p>
                        <span
                          className="death-order-item-label"
                        >
                          Name: 
                        </span>
                        JAMES
                         
                        HOWLETT (LOGAN)
                      </p>
                      <p>
                        <span
                          className="death-order-item-label"
                        >
                          SS Included: 
                        </span>
                        No
                      </p>
                      <p>
                        <span
                          className="death-order-item-label"
                        >
                          Quantity: 
                        </span>
                        2
                      </p>
                    </div>
