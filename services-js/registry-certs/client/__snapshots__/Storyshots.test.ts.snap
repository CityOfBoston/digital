              </a>
            </li>
          </ul>
        </nav>
      </div>
      <div
        className="a11y--content-start"
        id="content-start"
      />
      <main
        className="b-ff"
      >
        <div
          aria-live="polite"
          className="b-c b-c--hsm "
        >
          <section
            className="m-t500"
          >
            <h2
              className="emotion-2"
            >
              Payment
            </h2>
            <div
              className="m-v300"
            >
              <div
                className="emotion-3"
              >
                <button
                  aria-expanded={false}
                  className="drawerHeader "
                  onClick={[Function]}
                  type="button"
                >
                  Your order details
                  <div
                    className="arrow"
                  />
                </button>
                <div
                  className="body"
                >
                  <div
                    role="region"
                  />
                </div>
              </div>
            </div>
            <form
              acceptCharset="UTF-8"
              className="emotion-4"
              method="post"
              onSubmit={[Function]}
            >
              <div
                className="row info-row"
              >
                <div
                  className="col"
                >
                  <label
                    className="header"
                  >
                    Shipping Address
                  </label>
                  <div
                    className="m-b200"
                  >
                    Dorm Hall, Apt 5, 10 College Avenue, New York NY 12345
                  </div>
                </div>
                <div
                  className="col"
                >
                  <a
                    aria-label="Edit contact information"
                    className="btn"
                    href="/marriage/checkout?page=shipping"
                    onClick={[Function]}
                    onMouseEnter={[Function]}
                  >
                    edit
                  </a>
                </div>
              </div>
              <fieldset
                className="fs m-v700"
              >
                <legend
                  className="fs-l"
                >
                  Payment method
                </legend>
                <div
                  className="txt"
                >
                  <label
                    className="txt-l txt-l--sm"
                    htmlFor="cardholderName"
                  >
                    Cardholder Name
                     
                    <span
                      aria-hidden={true}
                      className="t--req"
                    >
                      Required
                    </span>
                  </label>
                  <input
                    aria-required="true"
                    className="txt-f "
                    id="cardholderName"
                    name="cardholderName"
                    onBlur={[Function]}
                    onChange={[Function]}
                    type="text"
                    value="Nancy Whitehead"
                  />
                </div>
                <div
                  className="txt"
                >
                  <label
                    className="txt-l txt-l--sm"
                    htmlFor="card-number"
                  >
                    Credit or Debit Card 
                    <span
                      className="t--req"
                    >
                      Required
                    </span>
                  </label>
                  <div />
                  <div
                    className="t--info m-t200"
                  >
                    We accept Visa, MasterCard, and Discover.
                  </div>
                </div>
              </fieldset>
              <fieldset
                className="fs m-v700"
              >
                <legend
                  className="fs-l"
                >
                  Billing Address
                </legend>
                <div
                  className="m-v200"
                >
                  <div
                    role="radiogroup"
                  >
                    <label
                      className="ra"
                    >
                      <input
                        checked={true}
                        className="ra-f"
                        name="billingAddressSameAsShippingAddress"
