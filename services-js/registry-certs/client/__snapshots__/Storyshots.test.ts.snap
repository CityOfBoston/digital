  appearance: none;
  border-radius: 0;
  border: 0;
  padding: 0.3em 1em 0.25em 0.25em;
  margin-left: 0.25rem;
  font-family: Lora;
  font-size: 18px;
  font-style: normal;
  font-weight: 400;
  line-height: normal;
  color: #1871bd;
