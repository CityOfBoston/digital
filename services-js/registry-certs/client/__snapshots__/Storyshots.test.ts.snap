  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-flex-wrap: wrap;
  -ms-flex-wrap: wrap;
  flex-wrap: wrap;
  -webkit-align-items: center;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
  -ms-flex-pack: justify;
  justify-content: space-between;
  margin-bottom: 0.75rem;
  padding: 0.5rem 0;
  border-bottom: 1px solid #e0e0e0;
}

.emotion-30 li .name {
  font-family: Lora,Georgia,serif;
  font-size: 1rem;
}

<div
    className="mn--full-ie"
  >
    <div
      className="mn mn--full mn--nv-s"
    >
      <input
        aria-hidden="true"
        className="s-tr"
        id="s-tr"
        type="checkbox"
      />
      <header
        className="h"
        dangerouslySetInnerHTML={
          Object {
            "__html": "
  <label for=\\"brg-tr\\" class=\\"brg-b\\">
    <div class=\\"brg\\">
      <span class=\\"brg-c\\">
        <span class=\\"brg-c-i\\"></span>
      </span>
      <span class=\\"brg-t\\"><span class=\\"a11y--h\\">Toggle </span>Menu</span>
    </div>
  </label>

  <div class=\\"lo lo--abs\\">
    <div class=\\"lo-l\\">
      <a href=\\"https://www.boston.gov/\\" title=\\"Home | Boston.gov\\">
        <img src=\\"https://patterns.boston.gov/images/public/logo.svg\\" alt=\\"Home | Boston.gov\\" class=\\"lo-i\\">
      </a>
      <span class=\\"lo-t\\"><a href=\\"https://www.boston.gov/mayor\\">Mayor Michelle Wu</a></span>
    </div>
  </div>
  <a id=\\"seal\\" href=\\"https://www.boston.gov/\\" title=\\"Home | Boston.gov\\" rel=\\"home\\" class=\\"s\\">
  <img src=\\"https://patterns.boston.gov/images/public/seal.svg\\" alt=\\"Home | Boston.gov\\" class=\\"s-i\\" />
</a>

<nav class=\\"nv-h\\">
  <ul class=\\"nv-h-l\\">
    <li class=\\"nv-h-l-i\\"><a href=\\"https://www.boston.gov/pay-and-apply\\" title=\\"Pay and apply\\" class=\\"nv-h-l-a\\">Pay and apply</a></li>
    <li class=\\"nv-h-l-i\\"><a href=\\"https://www.boston.gov/public-notices\\" title=\\"Public notices\\" class=\\"nv-h-l-a\\">Public notices</a></li>
    <li class=\\"nv-h-l-i\\"><a href=\\"mailto:feedback@boston.gov\\" title=\\"Feedback\\" class=\\"nv-h-l-a\\" onClick=\\"document.getElementById(&quot;contactForm&quot;).show(); return false;\\">Feedback</a></li>
    <li class=\\"tr nv-h-l-i\\">
      <a href=\\"https://www.boston.gov/#translate\\" title=\\"Translate\\" class=\\"nv-h-l-a nv-h-l-a--k--s tr-link\\">Translate</a>
      <ul class=\\"tr-dd\\">
        <li><span class=\\"notranslate tr-dd-link tr-dd-link--message\\">Loading...</span></li>
        <li><a href=\\"https://www.boston.gov/#\\" class=\\"notranslate tr-dd-link\\" data-ln=\\"ht\\">Krey&#xF2;l Ayisyen</a></li>
        <li><a href=\\"https://www.boston.gov/#\\" class=\\"notranslate tr-dd-link\\" data-ln=\\"pt\\">Portugese</a></li>
        <li><a href=\\"https://www.boston.gov/#\\" class=\\"notranslate tr-dd-link\\" data-ln=\\"es\\">Espa&#xF1;ol</a></li>
        <li><a href=\\"https://www.boston.gov/#\\" class=\\"notranslate tr-dd-link\\" data-ln=\\"vi\\">Ti&#x1EBF;ng Vi&#x1EC7;t</a></li>
        <li><a href=\\"https://www.boston.gov/#\\" class=\\"notranslate tr-dd-link tr-dd-link--hidden\\" data-ln=\\"en\\">English</a></li>
      </ul>
    </li>
    <li class=\\"nv-h-l-i\\">
      <label for=\\"s-tr\\" title=\\"Search\\" class=\\"nv-h-l-a nv-h-l-a--k nv-h-l-a-ic\\" id=\\"searchIcon\\">
        <svg id=\\"Layer_2\\" aria-label=\\"Search\\" xmlns=\\"http://www.w3.org/2000/svg\\" viewBox=\\"0 0 40 41\\"><title>Search</title><path class=\\"nv-h-l-a-i\\" d=\\"M24.2.6C15.8.6 9 7.4 9 15.8c0 3.7 1.4 7.2 3.6 9.8L1.2 37c-.8.8-.8 2 0 2.8.4.4.9.6 1.4.6s1-.2 1.4-.6l11.5-11.5C18 30 21 31 24.2 31c8.4 0 15.2-6.8 15.2-15.2C39.4 7.4 32.6.6 24.2.6zm0 26.5c-6.2 0-11.2-5-11.2-11.2S18 4.6 24.2 4.6s11.2 5 11.2 11.2-5 11.3-11.2 11.3z\\"/></svg>
      </label>
    </li>
  </ul>
</nav>

<div class=\\"h-s\\">
  <form class=\\"sf\\" action=\\"https://www.boston.gov/search\\" accept-charset=\\"UTF-8\\" method=\\"get\\">
    <input name=\\"utf8\\" type=\\"hidden\\" value=\\"&#x2713;\\">
    <div class=\\"sf-i\\">
      <input type=\\"text\\" name=\\"query\\" id=\\"query\\" value=\\"\\" placeholder=\\"Search&#x2026;\\" class=\\"sf-i-f\\" autocomplete=\\"off\\" aria-label=\\"Search\\">
      <button class=\\"sf-i-b\\">Search</button>
    </div>
  </form>
</div>
  ",
          }
        }
        role="banner"
      />
      <nav
        aria-label="Shopping cart"
        className="nv-s nv-s--sticky"
      >
        <div
          className="nv-s-l emotion-2"
        >
          <a
            className="nv-s-l-b emotion-1"
            onClick={[Function]}
            onMouseEnter={[Function]}
          >
            View Cart 
            <span
              className="emotion-0"
            >
              0
            </span>
          </a>
        </div>
      </nav>
      <nav
        aria-label="Breadcrumbs"
        className="brc p-a300 emotion-4"
      >
        <ul
          className="brc-l"
        >
          <li
            className="brc-l-i"
          >
            <a
              href="https://www.boston.gov/"
            >
              Home
            </a>
            <span
              aria-hidden="true"
              className="brc-s"
              style={
                Object {
                  "cursor": "default",
                }
              }
            >
               
              ›
               
            </span>
          </li>
          <li
            className="brc-l-i"
          >
            <a
              href="https://www.boston.gov/departments"
            >
              Departments
            </a>
            <span
              aria-hidden="true"
              className="brc-s"
              style={
                Object {
                  "cursor": "default",
                }
              }
            >
               
              ›
               
            </span>
          </li>
          <li
            className="brc-l-i"
          >
            <a
              href="https://www.boston.gov/departments/registry"
            >
              Registry: Birth, death, and marriage and marriage intention
            </a>
            <span
              aria-hidden="true"
              className="brc-s"
              style={
                Object {
                  "cursor": "default",
                }
              }
            >
               
              ›
               
            </span>
          </li>
          <li
            className="brc-l-i"
          >
            <a
              aria-current="page"
              className="emotion-3"
              href="/death"
            >
              Death certificates
            </a>
          </li>
        </ul>
      </nav>
      <div
        className="a11y--content-start"
        id="content-start"
      />
      <main
        className="b-ff"
      >
        <div
          className="b-c b-c--nbp emotion-53"
        >
          <h1
            className="emotion-5"
          >
            Request a death certificate
          </h1>
          <div
            className="emotion-7"
          >
            <div
              className="emotion-6"
            >
              <progress
                aria-valuemax={7}
                aria-valuemin={1}
                aria-valuenow={3}
                aria-valuetext="Step 3 of 7"
                max={7}
                value={2}
              >
                Step 3 of 7
              </progress>
              <span
                aria-hidden="true"
              >
                Step 3 of 7
              </span>
            </div>
          </div>
          <h2
            className="emotion-8"
          >
            Certificate options
          </h2>
          <div
            className="emotion-52"
          >
            <div
              className="emotion-10"
            >
              <p>
                By law, SSNs are not included on Massachusetts death certificates unless the requester has a legitimate need and provides supporting documentation.
                 
                <a
                  className="emotion-9"
                  href="https://www.boston.gov/departments/registry/how-get-death-certificate#social-security-numbers"
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  Why do we need to know?
                </a>
              </p>
              <p>
                Selecting “Yes” requires documentation and review before your request can be approved.
              </p>
            </div>
            <fieldset
              className="emotion-13"
            >
              <legend
                className="emotion-11"
              >
                Would you like the decedent’s Social Security Number (SSN) printed on the death certificate?
                 
                <span
                  className="t--req"
                >
                  Required
                </span>
              </legend>
              <div
                className="emotion-12"
              >
                <div
                  aria-label="SSN preference"
                  role="group"
                >
                  <label
                    className="ra  "
                  >
                    <input
                      checked={false}
                      className="ra-f"
                      name="includeSsn"
                      onChange={[Function]}
                      type="radio"
                      value="no"
                    />
                    <span
                      className="ra-l"
                    >
                      No, do not include the SSN
                    </span>
                  </label>
                  <label
                    className="ra  "
                  >
                    <input
                      checked={true}
                      className="ra-f"
                      name="includeSsn"
                      onChange={[Function]}
                      type="radio"
                      value="yes"
                    />
                    <span
                      className="ra-l"
                    >
                      Yes, include the SSN
                    </span>
                  </label>
                </div>
              </div>
            </fieldset>
            <div
              className="emotion-14"
            >
              <img
                alt=""
                height={30}
                src="/assets/images/death-ssn-alert.svg"
                width={30}
              />
              <p>
                Your SSN selection will apply to all copies of this death certificate in this order
              </p>
            </div>
            <div>
              <h3
                className="emotion-15"
              >
                Additional verification required
              </h3>
              <div
                className="emotion-48"
              >
                <div
                  className="emotion-22"
                >
                  <div
                    className="emotion-20"
                  >
                    <label
                      className="emotion-16"
                      htmlFor="relationship"
                    >
                      Your Relationship to the Decedent
                       
                      <span
                        className="t--req"
                      >
                        Required
                      </span>
                    </label>
                    <div
                      className="emotion-19"
                    >
                      <select
                        aria-required={true}
                        className="emotion-17"
                        id="relationship"
                        name="relationship"
                        onChange={[Function]}
                        value="spouse"
                      >
                        <option
                          value=""
                        >
                          Select one
                        </option>
                        <option
                          value="spouse"
                        >
                          Spouse / Domestic Partner
                        </option>
                        <option
                          value="child"
                        >
                          Child
                        </option>
                        <option
                          value="parent"
                        >
                          Parent
                        </option>
                        <option
                          value="familyMember"
                        >
                          Other Family Member
                        </option>
                        <option
                          value="friend"
                        >
                          Friend
                        </option>
                        <option
                          value="client"
                        >
                          Client (Attorney / Authorized)
                        </option>
                        <option
                          value="other"
                        >
                          Other
                        </option>
                      </select>
                      <span
                        aria-hidden="true"
                        className="emotion-18"
                      >
                        <svg
                          fill="none"
                          height="9"
                          viewBox="0 0 17 9"
                          width="17"
                        >
                          <path
                            d="M1 1L8.5 8L16 1"
                            stroke="#1871bd"
                            strokeLinecap="round"
                            strokeLinejoin="round"
                            strokeWidth="2"
                          />
                        </svg>
                      </span>
                    </div>
                  </div>
                  <p
                    className="emotion-21"
                  >
                    <strong>
                      Required document:
                    </strong>
                     
                    Marriage certificate or registered domestic partnership record that lists the decedent.
                     
                    <a
                      href="https://www.boston.gov/departments/registry/how-get-death-certificate#social-security-numbers"
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      View accepted document
                    </a>
                  </p>
                </div>
                <div
                  className="emotion-22"
                >
                  <div
                    className="emotion-23"
                  >
                    Upload Proof of Relationship or Authority
                     
                    <span
                      className="t--req"
                    >
                      Required
                    </span>
                  </div>
                  <div
                    className="m-b300"
                  >
                    <input
                      accept="image/jpeg,image/jpg,application/pdf,.jpg,.jpeg,.pdf"
                      className="emotion-24"
                      id="death-relationship-upload"
                      multiple={true}
                      onBlur={[Function]}
                      onChange={[Function]}
                      onFocus={[Function]}
                      type="file"
                    />
                    <div
                      className="emotion-29"
                      onDragLeave={[Function]}
                      onDragOver={[Function]}
                      onDrop={[Function]}
                    >
                      <img
                        alt=""
                        className="emotion-25"
                        height={24}
                        src="/assets/images/death-upload-icon.svg"
                        width={24}
                      />
                      <p
                        className="emotion-26"
                      >
                        Click to upload file or drag and drop
                      </p>
                      <p
                        className="emotion-27"
                      >
                        Supports: JPEG, JPG, PDF (25 MB Max)
                      </p>
                      <label
                        className="btn emotion-28"
                        htmlFor="death-relationship-upload"
                        onClick={[Function]}
                      >
                        Upload file
                      </label>
                    </div>
                    <ul
                      className="t--s400 emotion-30"
                    />
                  </div>
                </div>
                <div
                  className="emotion-22"
                >
                  <div
                    className="emotion-20"
                  >
                    <label
                      className="emotion-16"
                      htmlFor="identityDocumentType"
                    >
                      Proof of Identity
                       
                      <span
                        className="t--req"
                      >
                        Required
                      </span>
                    </label>
                    <div
                      className="emotion-19"
                    >
                      <select
                        aria-required={true}
                        className="emotion-17"
                        id="identityDocumentType"
                        name="identityDocumentType"
                        onChange={[Function]}
                        value="drivers-license"
                      >
                        <option
                          value=""
                        >
                          Select one
                        </option>
                        <option
                          value="drivers-license"
                        >
                          Driver's License
                        </option>
                        <option
                          value="state-id"
                        >
                          State ID
                        </option>
                        <option
                          value="passport"
                        >
                          Passport
                        </option>
                        <option
                          value="military-id"
                        >
                          Military ID
                        </option>
                        <option
                          value="other"
                        >
                          Other
                        </option>
                      </select>
                      <span
                        aria-hidden="true"
                        className="emotion-18"
                      >
                        <svg
                          fill="none"
                          height="9"
                          viewBox="0 0 17 9"
                          width="17"
                        >
                          <path
                            d="M1 1L8.5 8L16 1"
                            stroke="#1871bd"
                            strokeLinecap="round"
                            strokeLinejoin="round"
                            strokeWidth="2"
                          />
                        </svg>
                      </span>
                    </div>
                  </div>
                  <p
                    className="emotion-21"
                  >
                    <strong>
                      Required document:
                    </strong>
                     
                    Upload clear images of the front and back of your driver’s license.
                     
                    <a
                      href="https://www.boston.gov/departments/registry/how-get-death-certificate#social-security-numbers"
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      View accepted document
                    </a>
                  </p>
                </div>
                <div
                  className="emotion-22"
                >
                  <div
                    className="emotion-23"
                  >
                    Upload Proof of Identity
                     
                    <span
                      className="t--req"
                    >
                      Required
                    </span>
                  </div>
                  <div
                    className="m-b300"
                  >
                    <input
                      accept="image/jpeg,image/jpg,application/pdf,.jpg,.jpeg,.pdf"
                      className="emotion-24"
                      id="death-identity-upload"
                      multiple={true}
                      onBlur={[Function]}
                      onChange={[Function]}
                      onFocus={[Function]}
                      type="file"
                    />
                    <div
                      className="emotion-29"
                      onDragLeave={[Function]}
                      onDragOver={[Function]}
                      onDrop={[Function]}
                    >
                      <img
                        alt=""
                        className="emotion-25"
                        height={24}
                        src="/assets/images/death-upload-icon.svg"
                        width={24}
                      />
                      <p
                        className="emotion-26"
                      >
                        Click to upload file or drag and drop
                      </p>
                      <p
                        className="emotion-27"
                      >
                        Supports: JPEG, JPG, PDF (25 MB Max)
                      </p>
                      <label
                        className="btn emotion-28"
                        htmlFor="death-identity-upload"
                        onClick={[Function]}
                      >
                        Upload file
                      </label>
                    </div>
                    <ul
                      className="t--s400 emotion-30"
                    />
                  </div>
                </div>
              </div>
            </div>
            <div
              className="emotion-51"
            >
              <button
                className="emotion-49"
                onClick={[Function]}
                type="button"
              >
                Back
              </button>
              <button
                className="btn emotion-50"
                disabled={true}
                onClick={[Function]}
                type="button"
              >
                Add to order
              </button>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>,
  <footer
    className="ft"
    dangerouslySetInnerHTML={
      Object {
        "__html": "
<div class=\\"ft-c ft-ite\\">
  <ul class=\\"ft-ll ft-ite-links\\">
    <li class=\\"ft-ll-i\\">
      <a href=\\"http://www.cityofboston.gov/311/\\" class=\\"ft-ll-a lnk--yellow\\">
        BOS:311 - Report an issue
      </a>
    </li>

    <li class=\\"ft-ll-i\\">
      <a href=\\"https://www.boston.gov/departments/innovation-and-technology/privacy-and-security-statement\\" target=\\"_blank\\" title=\\"\\" class=\\"ft-ll-a\\">Privacy Policy</a>
    </li>
    <li class=\\"ft-ll-i\\">
      <a href=\\"https://www.boston.gov/departments/mayors-office/contact-boston-city-hall\\" title=\\"\\" class=\\"ft-ll-a\\">Contact us</a>
    </li>
    <li class=\\"ft-ll-i\\">
      <a href=\\"https://www.boston.gov/departments/digital-team/city-boston-alerts-and-notifications\\" title=\\"\\" class=\\"ft-ll-a\\">Alerts and notifications</a>
    </li>
    <li class=\\"ft-ll-i\\">
      <a href=\\"https://www.boston.gov/departments/public-records\\" title=\\"\\" class=\\"ft-ll-a\\">Public records requests</a>
    </li>
  </ul>

  <ul class=\\"ft-ll ft-ite-311\\">
    <li class=\\"ft-ll-i\\">
      <a href=\\"http://www.cityofboston.gov/311/\\" class=\\"ft-ll-a lnk--yellow\\">
        <span class=\\"ft-ll-311\\">BOS:311</span>
        <span class=\\"tablet--hidden\\"> - </span>
        Report an issue
      </a>
    </li>
  </ul>
</div>
",
      }
    }
    style={
      Object {
        "position": "relative",
        "zIndex": 2,
      }
    }
  />,
]
`;

exports[`Storyshots Death/CertificateOptionsPage certificate missing 1`] = `
Array [
  <a
    className="btn a11y--h a11y--f"
    href="#content-start"
    onClick={[Function]}
    style={
      Object {
        "margin": 4,
      }
    }
    tabIndex={1}
  >
    Jump to content
  </a>,
  <input
    aria-label="Open Boston.gov menu"
    className="brg-tr"
    id="brg-tr"
    onKeyDown={[Function]}
    type="checkbox"
  />,
  <nav
    aria-label="Boston.gov menu"
    className="nv-m"
    dangerouslySetInnerHTML={
      Object {
        "__html": "
  <div class=\\"nv-m-h\\">
      <div class=\\"nv-m-h-ic\\">
        <a href=\\"https://www.boston.gov/\\" title=\\"Go to home page\\">
          <img src=\\"https://patterns.boston.gov/images/b-dark.svg\\" title=\\"B\\" aria-hidden=\\"true\\" class=\\"nv-m-h-i\\">
        </a>
      </div>
      <div id=\\"nv-m-h-t\\" class=\\"nv-m-h-t\\">&#xA0;</div>
  </div>
  <div class=\\"nv-m-c\\">
    

<ul class=\\"nv-m-c-l\\"><li class=\\"nv-m-c-l-i is-l first leaf menu-mlid-763366 nv-m-c-a--y\\"><a href=\\"http://www.cityofboston.gov/311/\\" title=\\"\\" class=\\"nv-m-c-a nv-m-c-a--p three-one-one\\">Help / 311</a></li>
<li class=\\"nv-m-c-l-i is-l leaf menu-mlid-210101\\"><a href=\\"https://www.boston.gov/homepage\\" class=\\"nv-m-c-a nv-m-c-a--p\\">Home</a></li>
<li class=\\"nv-m-c-l-i is-l leaf menu-mlid-171721\\"><a href=\\"https://www.boston.gov/guides\\" class=\\"nv-m-c-a nv-m-c-a--p\\">Guides to Boston</a></li>
<li class=\\"nv-m-c-l-i is-l leaf menu-mlid-171726\\"><a href=\\"https://www.boston.gov/departments\\" class=\\"nv-m-c-a nv-m-c-a--p\\">Departments</a></li>
<li class=\\"nv-m-c-l-i is-l leaf menu-mlid-1675906\\"><a href=\\"https://www.boston.gov/public-notices\\" title=\\"\\" class=\\"nv-m-c-a nv-m-c-a--p\\">Public Notices</a></li>
<li class=\\"nv-m-c-l-i is-l leaf menu-mlid-2354776\\"><a href=\\"https://www.boston.gov/pay-and-apply\\" class=\\"nv-m-c-a nv-m-c-a--p\\">Pay and apply</a></li>
<li class=\\"nv-m-c-l-i is-l leaf menu-mlid-2354781\\"><a href=\\"https://www.boston.gov/career-center\\" class=\\"nv-m-c-a nv-m-c-a--p\\">Work for the City</a></li>
