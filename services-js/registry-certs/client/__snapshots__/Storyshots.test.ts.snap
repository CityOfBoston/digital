.emotion-6 {
  display: block;
  box-sizing: border-box;
  width: 100%;
  padding: 8px;
  border: 1px solid #d2d2d2;
  background-color: #fff;
  -webkit-text-decoration: none;
  text-decoration: none;
  cursor: pointer;
  color: inherit;
}

.emotion-6:hover,
.emotion-6:focus {
  background-color: #1871bd;
  border-color: #1871bd;
}

.emotion-6:hover .search-result-name,
.emotion-6:focus .search-result-name,
.emotion-6:hover .search-result-pending,
.emotion-6:focus .search-result-pending,
.emotion-6:hover .search-result-detail,
.emotion-6:focus .search-result-detail,
.emotion-6:hover .search-result-detail *,
.emotion-6:focus .search-result-detail * {
  color: #fff;
}

.emotion-5 {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-flex-direction: column;
  -ms-flex-direction: column;
  flex-direction: column;
  gap: 8px;
  min-width: 0;
}

.emotion-0 {
  font-family: Montserrat,Arial,sans-serif;
  font-weight: 700;
  font-size: 1.125rem;
  line-height: 1.2;
  color: #1871bd;
}

.emotion-2 {
  margin: 0;
  font-family: Lora,Georgia,serif;
  font-weight: 400;
  font-size: 1rem;
  line-height: 1.2;
  color: #091f2f;
}

.emotion-1 {
  font-weight: 600;
}

<a
  className="emotion-6"
  onClick={[Function]}
  onMouseEnter={[Function]}
>
  <div
    className="emotion-5"
  >
    <div
      className="search-result-name emotion-0"
    >
      MONKEY JOE
    </div>
    <p
      className="search-result-detail emotion-2"
    >
      <span
        className="emotion-1"
      >
        Date of death:
      </span>
       
      2004
    </p>
    <p
      className="search-result-detail emotion-2"
    >
      <span
        className="emotion-1"
      >
        Age:
      </span>
       
      6
    </p>
  </div>
</a>
`;

