      <div
        className="a11y--content-start"
        id="content-start"
      />
      <main
        className="b-ff"
      >
        <div
          className="b-c b-c--nbp  emotion-8"
        >
          <h1
            className="emotion-2"
          >
            Request a death certificate
          </h1>
          <div
            className="emotion-4"
          >
            <div
              className="emotion-3"
            >
              <progress
                aria-valuemax={7}
                aria-valuemin={1}
                aria-valuenow={7}
                aria-valuetext="Step 7 of 7"
                max={7}
                value={7}
              >
                Step 7 of 7
              </progress>
              <span
                aria-hidden="true"
              >
                Step 7 of 7
              </span>
            </div>
          </div>
          <h2
            className="emotion-5"
          >
            Review order
          </h2>
          <div
            className="emotion-7"
          >
            <div
              className="t--info m-v500"
            >
              Your order is not yet complete. Please check the information below, then click the 
              <b>
                Submit Order
              </b>
               button.
            </div>
            <form
              acceptCharset="UTF-8"
              method="post"
              onSubmit={[Function]}
            >
              <div
                className="row info-row"
              >
                <div
                  className="col"
                >
                  <label
                    className="header"
                  >
                    Contact Information
                  </label>
                  <div
                    className="info"
                  >
                    squirrel.girl@avengers.org
                  </div>
                  <div
                    className="info"
                  >
                    (555) 123-9999
                  </div>
                </div>
                <div
                  className="col"
                >
                  <a
                    aria-label="Edit contact information"
                    className="btn"
                    href="/death/checkout?page=shipping"
                    onClick={[Function]}
                    onMouseEnter={[Function]}
                  >
                    edit
                  </a>
                </div>
              </div>
              <div
                className="row info-row"
              >
                <div
                  className="col"
                >
                  <label
                    className="header"
                  >
                    Shipping Address
                  </label>
                  <div>
                    Doreen Green
                  </div>
                  <div>
                    Empire State University
                  </div>
                  <div>
                    Dorm Hall, Apt 5
                  </div>
                  <div>
                    10 College Avenue
                  </div>
                  <div>
                    New York, NY 12345
                  </div>
