  .emotion-1 {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.emotion-0 {
  color: #d22d23;
}

.emotion-6 {
  color: #091f2f;
  font-family: Lora,Georgia,serif;
  font-size: 18px;
  font-style: normal;
  font-weight: 400;
  line-height: normal;
  margin: auto;
  width: 100%;
}

.emotion-6 h1 {
  font-family: Montserrat,Arial,sans-serif;
  font-weight: 700;
  font-size: 18px;
  text-transform: uppercase;
  margin-bottom: 14px;
}

.emotion-6 span.bold {
  font-weight: 700;
}

.emotion-6 .row {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-align-items: center;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
  margin-bottom: 12px;
  line-height: 1.25rem;
  min-height: 1.25rem;
}

.emotion-6 .row .col {
  white-space: 'rap';
  -webkit-flex: min-content;
  -ms-flex: min-content;
  flex: min-content;
}

.emotion-6 .row .col:nth-of-type(2) {
  text-align: right;
  max-width: 30%;
}

.emotion-6 .row .labeled-select {
  line-height: 1.25rem;
}

.emotion-6 .row .labeled-select label {
  line-height: 1.25rem;
}

.emotion-6 .row .labeled-select select {
  padding-top: 0;
  padding-bottom: 0;
  line-height: 1.25rem;
  height: 1.25rem;
}

.emotion-6 .row:nth-last-of-type(-n + 1) {
  font-family: Montserrat,Arial,sans-serif;
  font-size: 24px;
  font-weight: 700;
  text-transform: uppercase;
  border-top: 1px solid #58585b;
  padding-top: 16px;
  margin-top: 16px;
}

@media screen and (max-width:480px) {
  .emotion-6 .total-cost {
    font-size: 15px;
  }
}

.emotion-3 progress {
  margin: 1rem 0 0.25rem;
  width: 100%;
  height: 1rem;
  border: 2px solid #091f2f;
  background-color: #fff;
}

.emotion-3 progress::-webkit-progress-bar {
  background-color: #fff;
}

.emotion-3 progress::-webkit-progress-value {
  -webkit-transition: width 0.5s;
  transition: width 0.5s;
  background-color: #288be4;
}

.emotion-3 progress::-moz-progress-bar {
