  .emotion-1 {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.emotion-0 {
  color: #d22d23;
}

.emotion-9 fieldset + fieldset {
  margin-top: 2rem;
}

@media screen and (min-width:480px) {
  .emotion-9 fieldset + fieldset {
    margin-top: 4rem;
  }

  .emotion-9 fieldset + fieldset .lnk {
    padding-left: 0;
  }
}

.emotion-8 {
  margin: 0;
  padding: 0;
  border: none;
}

.emotion-8 legend {
  padding-left: 0;
  padding-right: 0;
  width: 100%;
}

.emotion-8 h2 {
  margin-bottom: 0;
  font-family: Montserrat,Arial,sans-serif;
  font-weight: 700;
  color: #091f2f;
}

.emotion-8 .desc {
  margin: 0.5rem 0 0.75rem;
  font-family: Lora,Georgia,serif;
  font-size: 0.9375em;
  font-weight: 100;
  color: #58585b;
  line-height: 1.2em;
}

.emotion-4 {
  padding-bottom: 0.25rem;
  margin-bottom: 0;
  font-family: Montserrat,Arial,sans-serif;
  font-weight: 700;
  font-size: 1.5rem;
  color: #091f2f;
  text-transform: uppercase;
}

.emotion-4.secondary {
  margin-bottom: 1rem;
  font-size: 1.25rem;
  border-width: 3px;
}

.emotion-4.secondary em {
