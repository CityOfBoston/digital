}

.emotion-0 .progressbar .nav a {
  display: table-cell;
  border-width: 1px;
  border-color: black;
  border-style: solid;
  border-left-width: 0;
  padding: 0.85em 0.5em;
  color: black;
  background: #fff;
  width: 2%;
  font-size: 0.85em;
  vertical-align: middle;
}

.emotion-0 .progressbar .nav a:last-child {
  grid-column-start: 2;
}

.emotion-0 .progressbar .nav a:first-of-type {
  border-left-width: 1px;
}

.emotion-0 .progressbar .nav a.completed,
.emotion-0 .progressbar .nav a.completed.current {
  cursor: pointer;
  color: #fff;
  background: #1871bd;
}

.emotion-0 .progressbar .nav a.uncompleted {
  background: #C8C8C8;
}

.emotion-0 .progressbar .nav a.completed.focused.current {
  color: #000;
  cursor: pointer;
  background: #f2f2f2;
}

.emotion-0 .progressbar .nav a.completed.focused,
.emotion-0 .progressbar .nav a.completed:hover {
  color: #000;
  cursor: pointer;
  background: #b0d9ff;
}

.emotion-0 .progressbar .nav a.done,
.emotion-0 .progressbar .nav a.done:hover,
.emotion-0 .progressbar .nav a.completed.focused.done.current {
  color: #000;
  cursor: default;
  background: #f2f2f2;
}

.emotion-0 .progressbar .nav a.completed.current {
  color: #000;
  background: #f2f2f2;
}

.emotion-0 .progressbar .progress-text {
  -webkit-box-pack: end;
  -webkit-justify-content: flex-end;
  -ms-flex-pack: end;
  justify-content: flex-end;
  font-style: italic;
  font-size: 1rem;
  margin-top: 0.5rem;
}

.emotion-0 .progressbar .progress-text .mobile {
  display: none;
}

@media screen and (max-width:540px) {
  .emotion-0 {
    max-width: 25.875em;
  }

  .emotion-0 .progressbar .nav a {
    overflow: hidden;
    min-width: 10px;
    padding: 0.5em 0;
    text-indent: -500px;
    line-height: 0;
  }

  .emotion-0 .progressbar .progress-text .mobile {
    display: inline-block;
  }
}

@media (min-width:541px) and (max-width:1024px) {
  .emotion-0 .progressbar .nav a {
    padding: 0.85em 0;
    font-size: 0.55rem;
  }
}

