                  <a
                    aria-label="Edit contact information"
                    className="btn"
                    href="/birth/checkout?page=shipping"
                    onClick={[Function]}
                    onMouseEnter={[Function]}
                  >
                    edit
                  </a>
                </div>
              </div>
              <fieldset
                className="fs m-v700"
              >
                <legend
                  className="fs-l"
                >
                  Payment method
                </legend>
                <div
                  className="txt"
                >
                  <label
                    className="txt-l txt-l--sm"
                    htmlFor="cardholderName"
                  >
                    Cardholder Name
                     
                    <span
                      aria-hidden={true}
                      className="t--req"
                    >
                      Required
                    </span>
                  </label>
                  <input
                    aria-required="true"
                    className="txt-f "
                    id="cardholderName"
                    name="cardholderName"
                    onBlur={[Function]}
                    onChange={[Function]}
                    type="text"
                    value="Nancy Whitehead"
                  />
                </div>
                <div
                  className="txt"
                >
                  <label
                    className="txt-l txt-l--sm"
                    htmlFor="card-number"
                  >
                    Credit or Debit Card 
                    <span
                      className="t--req"
                    >
                      Required
                    </span>
                  </label>
                  <span
                    className="txt-f"
                    style={
                      Object {
                        "borderColor": "transparent",
                        "width": "auto",
                      }
                    }
                  >
                    •••• •••• •••• 
                    4040
                  </span>
                  <button
                    className="lnk"
                    onClick={[Function]}
                    style={
                      Object {
                        "fontStyle": "italic",
                      }
                    }
                  >
                    update
                  </button>
                </div>
              </fieldset>
              <fieldset
                className="fs m-v700"
              >
