      <div
        className="a11y--content-start"
        id="content-start"
      />
      <main
        className="b-ff"
      >
        <div
          className="b-c b-c--nbp emotion-19"
        >
          <h1
            className="emotion-5"
          >
            Request a death certificate
          </h1>
          <div
            className="emotion-7"
          >
            <div
              className="emotion-6"
            >
              <progress
                aria-valuemax={7}
                aria-valuemin={1}
                aria-valuenow={3}
                aria-valuetext="Step 3 of 7"
                max={7}
                value={3}
              >
