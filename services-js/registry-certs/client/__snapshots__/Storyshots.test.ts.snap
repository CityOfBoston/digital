      </div>
      <div
        className="a11y--content-start"
        id="content-start"
      />
      <main
        className="b-ff"
      >
        <div
          className="b-c   emotion-8"
        >
          <h1
            className="emotion-2"
          >
            Request a death certificate
          </h1>
          <div
            className="emotion-4"
          >
            <div
              className="emotion-3"
            >
              <progress
                aria-valuemax={7}
                aria-valuemin={1}
                aria-valuenow={6}
                aria-valuetext="Step 6 of 7"
                max={7}
                value={6}
              >
                Step 6 of 7
              </progress>
              <span
                aria-hidden="true"
              >
                Step 6 of 7
              </span>
            </div>
          </div>
          <h2
            className="emotion-5"
          >
            Payment
          </h2>
          <div
            className="m-v300"
          >
            <div
              className="emotion-6"
            >
              <button
                aria-expanded={false}
                className="drawerHeader "
                onClick={[Function]}
                type="button"
              >
                Your order details
                <div
                  className="arrow"
                />
              </button>
              <div
                className="body"
              >
                <div
                  role="region"
                />
              </div>
            </div>
          </div>
          <form
            acceptCharset="UTF-8"
            className="emotion-7"
            method="post"
            onSubmit={[Function]}
          >
            <div
              className="row info-row"
            >
              <div
                className="col"
              >
                <label
                  className="header"
                >
                  Shipping Address
                </label>
                <div
                  className="m-b200"
                >
                  Dorm Hall, Apt 5, 10 College Avenue, New York NY 12345
                </div>
              </div>
              <div
                className="col"
              >
                <a
                  aria-label="Edit contact information"
                  className="btn"
                  href="/death/checkout?page=shipping"
                  onClick={[Function]}
                  onMouseEnter={[Function]}
                >
                  edit
                </a>
              </div>
            </div>
            <fieldset
              className="fs m-v700"
            >
              <legend
                className="fs-l"
              >
                Payment method
              </legend>
              <div
                className="txt"
              >
                <label
                  className="txt-l txt-l--sm"
                  htmlFor="cardholderName"
                >
                  Cardholder Name
                   
                  <span
                    aria-hidden={true}
                    className="t--req"
                  >
                    Required
                  </span>
                </label>
                <input
                  aria-required="true"
                  className="txt-f "
                  id="cardholderName"
                  name="cardholderName"
                  onBlur={[Function]}
                  onChange={[Function]}
                  type="text"
                  value="Nancy Whitehead"
                />
              </div>
              <div
                className="txt"
              >
                <label
                  className="txt-l txt-l--sm"
                  htmlFor="card-number"
                >
                  Credit or Debit Card 
                  <span
                    className="t--req"
                  >
                    Required
                  </span>
                </label>
                <span
                  className="txt-f"
                  style={
                    Object {
                      "borderColor": "transparent",
                      "width": "auto",
                    }
                  }
                >
                  •••• •••• •••• 
                  4040
                </span>
                <button
                  className="lnk"
                  onClick={[Function]}
                  style={
                    Object {
                      "fontStyle": "italic",
                    }
                  }
                >
                  update
                </button>
              </div>
            </fieldset>
            <fieldset
              className="fs m-v700"
            >
