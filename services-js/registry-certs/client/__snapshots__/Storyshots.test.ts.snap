                      className="header"
                    >
                      Shipping Address
                    </label>
                    <div>
                      Doreen Green
                    </div>
                    <div>
                      Empire State University
                    </div>
                    <div>
                      Dorm Hall, Apt 5
                    </div>
                    <div>
                      10 College Avenue
                    </div>
                    <div>
                      New York, NY 12345
                    </div>
                  </div>
                  <div
                    className="col"
                  >
                    <a
                      aria-label="Edit contact information"
                      className="btn"
                      href="/marriage/checkout?page=shipping"
                      onClick={[Function]}
                      onMouseEnter={[Function]}
                    >
                      edit
                    </a>
                  </div>
                </div>
                <div
                  className="row info-row"
                >
                  <div
                    className="col"
                  >
                    <label
                      className="header"
                    >
                      Payment Information
                    </label>
                    <div>
                      Nancy Whitehead
                    </div>
                    <div>
                      •••• •••• •••• 
                      4040
                    </div>
                    <div>
                      3 Avengers Towers
                    </div>
                    <div>
                      New York
                      , 
                      NY
                       
                      12223
                    </div>
                  </div>
                  <div
                    className="col"
                  >
                    <a
                      aria-label="Edit contact information"
                      className="btn"
                      href="/marriage/checkout?page=payment"
                      onClick={[Function]}
                      onMouseEnter={[Function]}
                    >
                      edit
                    </a>
                  </div>
                </div>
                <div
                  className="row"
                >
                  <div
                    className="col"
                  >
                    <label
                      className="header"
                    >
                      Order Details
                    </label>
                  </div>
                  <div
                    className="col"
                  >
                    <a
                      aria-label="Edit contact information"
                      className="btn"
                      href="/marriage/review"
                      onClick={[Function]}
                      onMouseEnter={[Function]}
                    >
                      edit
                    </a>
                  </div>
                </div>
                <div
                  className="certRow"
                >
                  <div>
                    <div
                      className="emotion-3"
                    >
                      <div
                        className="col"
                      >
                        <div
                          className="name-row"
                        >
                          <label>
                            Name: 
                          </label>
                          <span>
                            Laurel Johnson (Laurel Smith) and Terry Johnson (Terry Doe)
                          </span>
                        </div>
                        <div
                          className="name-row"
                        >
                          <label>
                            Date of marriage: 
                          </label>
                          <span>
                            06/10/2015
                          </span>
                        </div>
                        
                        <div>
                          Marriage Certificate Paper copy (with raised seal)
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div
                  className="m-v500"
                >
                  <h1
                    className="summary"
                  >
                    Order Summary
                  </h1>
                  <div
                    className="emotion-4"
                  >
                    <div
                      className="row"
                    >
                      <div
                        className="col"
                      >
                        Subtotal: 1 certificate × $14.00
                      </div>
                      <div
                        className="col"
                      >
                        $
                        14.00
                      </div>
                    </div>
                    
                    <div
                      className="row"
                    >
                      <div
                        className="col"
                      >
                        US Shipping
                      </div>
                      <div
                        className="col"
                      >
                        FREE
                      </div>
                    </div>
                    <div
                      className="row"
                    >
                      <div
                        className="col"
                      >
                        USPS Tracking®
                      </div>
                      <div
                        className="col"
                      >
                        $ 5.00
                      </div>
                    </div>
                    <div
                      className="row"
                    >
                      <div
                        className="col"
                      >
                        Service fee
                      </div>
                      <div
                        className="col"
                      >
                        $ 
                        0.66
                      </div>
                    </div>
                    <div
                      className="row"
                    >
                      <div
                        className="col"
                      >
                        Total
                      </div>
                      <div
                        className="col total-cost"
                      >
                        $ 
                        19.66
                      </div>
                    </div>
                  </div>
                </div>
                <div
                  className="m-v700"
                >
                  <div
                    className="t--info"
                    id="review-accept-heading"
                  >
                    You have to read and accept this checkbox before you place your order:
                  </div>
                  <div
                    className="m-v300"
                  >
                    <label
                      className="cb"
                      htmlFor="acceptNonRefundableInput"
                    >
                      <input
                        aria-required="true"
                        checked={false}
                        className="cb-f"
                        id="acceptNonRefundableInput"
                        name="acceptNonRefundable"
                        onChange={[Function]}
                        type="checkbox"
                        value="true"
                      />
                      <span
                        className="cb-l"
                      >
                        I understand that
                         
                        <strong>
                          marriage
                           certificates are non-refundable
                        </strong>
                        .
                      </span>
                    </label>
                  </div>
                </div>
                <div
                  className="m-v300"
                >
                  <button
                    aria-describedby="charge-message"
                    className="btn"
                    disabled={true}
                    style={
                      Object {
                        "display": "block",
                        "width": "100%",
                      }
                    }
                    type="submit"
                  >
                    Submit Order
                  </button>
                </div>
              </form>
            </div>
          </section>
        </div>
        <div
          className="b--g m-t700"
        >
          <div
            className="b-c b-c--smv b-c--hsm t--subinfo"
            id="service-fee"
          >
            * You are charged an extra service fee of not more than
             
            $0.25
             plus 
            2.15%
            . This fee goes directly to a third party to pay for the cost of credit card processing. Learn more about
             
            <a
              href="https://www.boston.gov/common-questions-about-online-payments"
            >
              credit card service fees
            </a>
             at the City of Boston.
          </div>
        </div>
      </main>
    </div>
  </div>,
  <footer
    className="ft"
    dangerouslySetInnerHTML={
      Object {
        "__html": "
<div class=\\"ft-c ft-ite\\">
  <ul class=\\"ft-ll ft-ite-links\\">
