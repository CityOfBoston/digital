.emotion-0 {
  color: #d22d23;
}

.emotion-6 {
  width: 100%;
  background: #e0e0e0;
  background: #f2f2f2;
  margin-bottom: 3.125rem;
}

.emotion-6 .drawerHeader {
  display: -webkit-box;
