  line-height: 1.2rem;
  text-transform: none;
  padding-top: 0.5em;
  margin-top: 0.25em;
  border-top: 4px solid #091f2f;
}

.emotion-0 .notice .tool-tip__wrapper {
  display: inline-block;
}

.emotion-3 {
  -webkit-flex-direction: column;
  -ms-flex-direction: column;
  flex-direction: column;
  margin-bottom: 1em;
}

.emotion-3 > label {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  margin-left: 0;
  margin-bottom: 1em;
}

.emotion-3 .radio-group__label label .ra-l {
  font-size: 0.8125rem;
}

.emotion-3 .radio-group__label .txt-l {
  font-size: 0.875em;
  margin-bottom: 0.75em;
  margin-top: 0;
}

@media screen and (min-width:768px) {
