                  <span
                    aria-hidden={true}
                    className="t--req"
                  >
                    Required
                  </span>
                </label>
                <input
                  aria-required="true"
                  autoComplete="name"
                  className="txt-f txt-f--100 "
                  id="contactName"
                  name="contactName"
                  onBlur={[Function]}
                  onChange={[Function]}
                  placeholder="Full name"
                  type="text"
                  value="Squirrel Girl"
                />
              </div>
              <div
                className="txt"
              >
                <label
                  className="txt-l txt-l--sm"
                  htmlFor="contactEmail"
                >
