                className="cb"
              >
                <input
                  checked={false}
                  className="cb-f"
                  id="storeContactAndShipping"
                  name="storeContactAndShipping"
                  onBlur={[Function]}
                  onChange={[Function]}
                  type="checkbox"
                  value="true"
                />
                <span
                  className="cb-l"
                >
                  Save contact and shipping info on this computer
                </span>
              </label>
            </div>
            <div
              className="g g--r g--vc"
            >
              <div
                className="g--5 ta-r m-b500"
              >
                <button
                  className="btn"
                  disabled={true}
                  type="submit"
                >
                  Next: Payment
                </button>
              </div>
              <div
                className="g--7 m-b500"
              >
                <a
                  href="/death/cart"
                  onClick={[Function]}
                  onMouseEnter={[Function]}
                  style={
                    Object {
                      "fontStyle": "italic",
                    }
                  }
                >
                  ← Back to cart
                </a>
              </div>
            </div>
          </form>
        </div>
      </main>
    </div>
  </div>,
  <footer
    className="ft"
    dangerouslySetInnerHTML={
      Object {
        "__html": "
