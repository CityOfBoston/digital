  .emotion-1 {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.emotion-0 {
  color: #d22d23;
}

.emotion-2 {
  padding-bottom: 0.25rem;
  margin-bottom: 0;
  font-family: Montserrat,Arial,sans-serif;
  font-weight: 700;
  font-size: 1.5rem;
  color: #091f2f;
  text-transform: uppercase;
}

.emotion-2.secondary {
  margin-bottom: 1rem;
  font-size: 1.25rem;
  border-width: 3px;
}

.emotion-2.secondary em {
  font-size: 1rem;
}

.emotion-5 .t--info {
  font-family: Lora,Georgia,serif;
  color: #091f2f;
  font-size: 20px;
  font-style: normal;
  font-weight: 400;
  line-height: normal;
}

.emotion-5 .sh-title {
  font-family: Lora,Georgia,serif;
  color: #091f2f;
  font-size: 24px;
}

.emotion-5 h1.summary {
  color: #091f2f;
  font-family: Montserrat,Arial,sans-serif;
  font-size: 18px;
  font-style: normal;
  font-weight: 700;
  text-transform: uppercase;
  margin-bottom: 0.5rem;
}

.emotion-5 .info-row {
  margin-bottom: 1.5rem;
  padding-bottom: 1.5em;
  border-bottom: 1px solid #d2d2d2;
  line-height: 1.5em;
}

.emotion-5 .certRow {
  color: #091f2f;
  font-family: Lora,Georgia,serif;
}

.emotion-5 .row {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
  -ms-flex-pack: justify;
  justify-content: space-between;
  -webkit-align-items: flex-start;
  -webkit-box-align: flex-start;
  -ms-flex-align: flex-start;
  align-items: flex-start;
  color: #091f2f;
  font-family: Lora,Georgia,serif;
}

.emotion-5 .row label.header {
  color: #091f2f;
  font-family: Montserrat,Arial,sans-serif;
  font-size: 24px;
  font-style: normal;
  font-weight: 700;
  line-height: normal;
  text-transform: uppercase;
}

.emotion-5 .row .info {
  margin-bottom: 0.5rem;
}

.emotion-5 .row .btn {
  font-family: Lora,Georgia,serif;
  color: #1871bd;
  text-align: center;
  font-size: 16px;
  font-style: normal;
  font-weight: 400;
  line-height: normal;
  text-transform: capitalize;
  background: #fff;
  border: 1px solid #d2d2d2;
  padding: 13px;
}

.emotion-5 .row .btn:hover {
  background: #1871bd;
  color: #fff;
}

.emotion-3 {
  dislay: flex;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
  -ms-flex-pack: justify;
  justify-content: space-between;
  -webkit-align-items: baseline;
  -webkit-box-align: baseline;
  -ms-flex-align: baseline;
  align-items: baseline;
  color: #091f2f;
  font-family: Lora,Georgia,serif;
  font-size: 1.125em;
  margin-bottom: 1.5rem;
  border-bottom: 1px solid #e0e0e0;
  padding: 18px 0 24px 0;
}

.emotion-3 .name-row {
  margin-bottom: 12px;
}

.emotion-3 .name-row label {
  font-weight: 700;
}

.emotion-3 .row {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
  -ms-flex-pack: justify;
  justify-content: space-between;
  -webkit-align-items: baseline;
  -webkit-box-align: baseline;
  -ms-flex-align: baseline;
  align-items: baseline;
  margin-bottom: 0.5rem;
}

.emotion-3 .row .col {
  background: transparent;
}

.emotion-3 label {
  color: #091f2f;
  font-family: Lora,Georgia,serif;
  font-size: 18px;
  font-weight: 600;
}

.emotion-3 label span {
  font-weight: normal;
}

.emotion-3 .mobile__visible {
  float: right;
}

@media screen and (max-width:480px) {
  .emotion-3 {
    font-size: 16px;
  }

  .emotion-3 .mobile,
  .emotion-3 .mobile__visible {
    display: -webkit-box;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    -webkit-flex-direction: column;
    -ms-flex-direction: column;
    flex-direction: column;
    -webkit-align-items: end;
    -webkit-box-align: end;
    -ms-flex-align: end;
    align-items: end;
    float: right;
  }

  .emotion-3 .mobile {
    display: none;
  }
}

.emotion-4 {
  color: #091f2f;
  font-family: Lora,Georgia,serif;
  font-size: 18px;
  font-style: normal;
  font-weight: 400;
  line-height: normal;
  margin: auto;
  width: 100%;
}

.emotion-4 h1 {
  font-family: Montserrat,Arial,sans-serif;
  font-weight: 700;
  font-size: 18px;
  text-transform: uppercase;
  margin-bottom: 14px;
}

.emotion-4 span.bold {
  font-weight: 700;
}

.emotion-4 .row {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-align-items: center;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
  margin-bottom: 12px;
  line-height: 1.25rem;
  min-height: 1.25rem;
}

.emotion-4 .row .col {
  white-space: 'rap';
  -webkit-flex: min-content;
  -ms-flex: min-content;
  flex: min-content;
}

.emotion-4 .row .col:nth-of-type(2) {
  text-align: right;
  max-width: 30%;
}

.emotion-4 .row .labeled-select {
  line-height: 1.25rem;
}

.emotion-4 .row .labeled-select label {
  line-height: 1.25rem;
}

.emotion-4 .row .labeled-select select {
  padding-top: 0;
  padding-bottom: 0;
  line-height: 1.25rem;
  height: 1.25rem;
}

.emotion-4 .row:nth-last-of-type(-n + 1) {
  font-family: Montserrat,Arial,sans-serif;
  font-size: 24px;
  font-weight: 700;
  text-transform: uppercase;
  border-top: 1px solid #58585b;
  padding-top: 16px;
  margin-top: 16px;
}

@media screen and (max-width:480px) {
  .emotion-4 .total-cost {
    font-size: 15px;
  }
}

<div
    className="mn--full-ie"
  >
    <div
      className="mn mn--full "
    >
