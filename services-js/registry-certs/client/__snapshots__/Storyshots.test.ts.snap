  .emotion-1 {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.emotion-0 {
  color: #d22d23;
}

.emotion-10 fieldset + fieldset {
  margin-top: 2rem;
}

@media screen and (min-width:480px) {
  .emotion-10 fieldset + fieldset {
    margin-top: 4rem;
  }

  .emotion-10 fieldset + fieldset .lnk {
    padding-left: 0;
  }
}

.emotion-9 {
  margin: 0;
  padding: 0;
  border: none;
}

.emotion-9 legend {
  padding-left: 0;
  padding-right: 0;
  width: 100%;
}

.emotion-9 h2 {
  margin-bottom: 0;
  font-family: Montserrat,Arial,sans-serif;
  font-weight: 700;
  color: #091f2f;
}

.emotion-9 .desc {
  margin: 0.5rem 0 0.75rem;
  font-family: Lora,Georgia,serif;
  font-size: 0.9375em;
  font-weight: 100;
  color: #58585b;
  line-height: 1.2em;
}

.emotion-12 {
  text-align: center;
}

@media screen and (min-width:480px) {
  .emotion-12 {
    margin-top: 2.5rem;
    text-align: left;
  }

  .emotion-12 > div {
    display: -webkit-box;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
  }

  .emotion-12 > div.ta-r > button {
    margin-left: auto;
  }

  .emotion-12 .lnk {
    padding-left: 0;
  }
}

.emotion-11 {
  padding: 1.25rem !important;
  padding-left: 0 !important;
}

.emotion-2 {
  padding-right: 0;
}

@media screen and (min-width:980px) {
  .emotion-2 {
    font-size: 34px;
  }
}

.emotion-3 {
  display: grid;
  margin: auto;
  margin-top: 0.75rem;
  grid-auto-columns: 1fr;
  grid-auto-rows: 1fr;
}

.emotion-3 .progressbar {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  width: 100%;
  -webkit-flex-direction: column;
  -ms-flex-direction: column;
  flex-direction: column;
  -webkit-align-items: stretch;
  -webkit-box-align: stretch;
  -ms-flex-align: stretch;
  align-items: stretch;
}

.emotion-3 .progressbar .nav {
  display: table;
  table-layout: fixed;
  text-align: center;
  line-height: normal;
  font-style: normal;
  font-weight: bold;
  font-family: Montserrat,Arial,sans-serif;
  text-transform: uppercase;
  color: '#58585B';
}

.emotion-3 .progressbar .nav a {
  display: table-cell;
  border-width: 1px;
  border-color: black;
  border-style: solid;
  border-left-width: 0;
  padding: 0.85em 0.5em;
  color: black;
  background: #fff;
  width: 2%;
  font-size: 0.85em;
  vertical-align: middle;
}

.emotion-3 .progressbar .nav a:last-child {
  grid-column-start: 2;
}

.emotion-3 .progressbar .nav a:first-of-type {
  border-left-width: 1px;
}

.emotion-3 .progressbar .nav a.completed,
.emotion-3 .progressbar .nav a.completed.current {
  cursor: pointer;
  color: #fff;
  background: #1871bd;
}

.emotion-3 .progressbar .nav a.uncompleted {
  background: #C8C8C8;
}

.emotion-3 .progressbar .nav a.completed.focused.current {
  color: #000;
  cursor: pointer;
  background: #f2f2f2;
}

.emotion-3 .progressbar .nav a.completed.focused,
.emotion-3 .progressbar .nav a.completed:hover {
  color: #000;
  cursor: pointer;
  background: #b0d9ff;
}

.emotion-3 .progressbar .nav a.done,
.emotion-3 .progressbar .nav a.done:hover,
.emotion-3 .progressbar .nav a.completed.focused.done.current {
  color: #000;
  cursor: default;
  background: #f2f2f2;
}

.emotion-3 .progressbar .nav a.completed.current {
  color: #000;
  background: #f2f2f2;
}

.emotion-3 .progressbar .progress-text {
  -webkit-box-pack: end;
  -webkit-justify-content: flex-end;
  -ms-flex-pack: end;
  justify-content: flex-end;
  font-style: italic;
  font-size: 1rem;
  margin-top: 0.5rem;
}

.emotion-3 .progressbar .progress-text .mobile {
  display: none;
}

@media screen and (max-width:540px) {
  .emotion-3 {
    max-width: 25.875em;
  }

  .emotion-3 .progressbar .nav a {
    overflow: hidden;
    min-width: 10px;
    padding: 0.5em 0;
    text-indent: -500px;
    line-height: 0;
  }

  .emotion-3 .progressbar .progress-text .mobile {
    display: inline-block;
  }
}

@media (min-width:541px) and (max-width:1024px) {
  .emotion-3 .progressbar .nav a {
    padding: 0.85em 0;
    font-size: 0.55rem;
  }
}

