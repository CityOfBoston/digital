        >
          <h1
            className="emotion-2"
          >
            Request a death certificate
          </h1>
          <div
            className="emotion-4"
          >
            <div
              className="emotion-3"
            >
              <progress
                aria-valuemax={7}
                aria-valuemin={1}
                aria-valuenow={5}
                aria-valuetext="Step 5 of 7"
                max={7}
                value={5}
              >
                Step 5 of 7
              </progress>
              <span
                aria-hidden="true"
              >
                Step 5 of 7
              </span>
            </div>
          </div>
          <h2
            className="emotion-5"
          >
