                </button>
              </div>
              <div
                className="g--7 m-b500"
              >
                <a
                  href="/death/cart"
                  onClick={[Function]}
                  onMouseEnter={[Function]}
                  style={
                    Object {
                      "fontStyle": "italic",
                    }
                  }
                >
                  ← Back to cart
                </a>
              </div>
            </div>
          </form>
        </div>
      </main>
    </div>
  </div>,
  <footer
    className="ft"
    dangerouslySetInnerHTML={
      Object {
        "__html": "
<div class=\\"ft-c ft-ite\\">
