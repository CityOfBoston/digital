  border: 1px solid #d2d2d2;
  padding: 0;
  background: #fff;
  -webkit-transition: background-color 0.15s ease,border-color 0.15s ease;
  transition: background-color 0.15s ease,border-color 0.15s ease;
}

.emotion-7 .death-accept-box:hover {
  background: #f2f2f2;
  border-color: #1871bd;
  cursor: pointer;
}

.emotion-7 .death-accept-box:active {
  background: #e8e8e8;
}

.emotion-7 .death-accept-box:focus-within {
  outline: 2px solid #1871bd;
  outline-offset: 2px;
}

.emotion-7 .death-accept-fieldset {
  border: 0;
  margin: 2.5rem 0;
  padding: 0;
  min-width: 0;
}

.emotion-7 .death-accept-legend {
  display: block;
  padding: 0;
  float: none;
  width: 100%;
}

.emotion-7 .death-accept-label.cb {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-align-items: center;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
  gap: 0;
  margin: 0;
  padding: 10px;
  width: 100%;
  min-height: 100%;
  box-sizing: border-box;
  cursor: pointer;
}

.emotion-7 .death-accept-checkbox.cb-f {
  position: relative;
  -webkit-flex-shrink: 0;
  -ms-flex-negative: 0;
  flex-shrink: 0;
  -webkit-align-self: center;
  -ms-flex-item-align: center;
  align-self: center;
  width: 22px;
  height: 22px;
  margin: 0 12px 0 0;
  padding: 0;
  -webkit-transform: none;
  -ms-transform: none;
  transform: none;
}

.emotion-7 .death-accept-checkbox.cb-f:before {
  position: absolute;
  top: 0;
  left: 0;
  width: 22px;
  height: 22px;
  border-width: 2px;
  background-size: 70% !important;
}

.emotion-7 .death-accept-text.cb-l {
  -webkit-flex: 1;
  -ms-flex: 1;
  flex: 1;
  min-width: 0;
  width: auto;
  margin-left: 0;
  font-family: Lora,Georgia,serif;
  font-size: 1.125rem;
  font-weight: 600;
  line-height: 1.35;
  color: #091f2f;
  white-space: normal;
}

.emotion-7 .death-charge-note {
  font-size: 1rem !important;
  line-height: 1.4;
}

