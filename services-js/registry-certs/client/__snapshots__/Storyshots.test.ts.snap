                }
              }
              type="button"
            >
              Upload back of ID
            </button>
          </div>
        </div>
      </div>
    </div>
    <fieldset
      className=" emotion-16"
    >
      <legend>
        <h3
          className="secondary m-t700 emotion-0"
          style={
            Object {
              "borderBottom": 0,
            }
          }
        >
          Have you had a legal name change or do you have court guardianship?
        </h3>
      </legend>
      <div
        onClick={[Function]}
      >
        <div
          className="m-b300"
        >
          <input
            accept="image/jpeg,image/png,image/tiff,image/bmp,application/pdf"
            className="emotion-13"
            id="uploadSupportingDocuments"
            multiple={true}
            onBlur={[Function]}
            onChange={[Function]}
            onFocus={[Function]}
            type="file"
          />
          <label
            className="btn btn--sm btn--200 emotion-14"
            htmlFor="uploadSupportingDocuments"
            onClick={[Function]}
            style={
              Object {
                "fontWeight": "bold",
                "whiteSpace": "nowrap",
              }
            }
          >
            Upload Supporting Documents
          </label>
          <div
            className="t--subinfo m-v200"
          >
            Files should be PDF format, and under 10MB each.
          </div>
          <ul
            className="t--s400 emotion-15"
          />
        </div>
      </div>
    </fieldset>
    <h2
      className="secondary m-t700 emotion-0"
    >
      No ID?
    </h2>
    <p
      className="m-b700 lh--400 t--s400 m-b500"
    >
      We can help explain your options.
       
      <a
        href="mailto:birth@boston.gov?subject=Birth%20Certificate%20Support%20Request%3A%20No%20ID"
        onClick={[Function]}
        onMouseUp={[Function]}
      >
        Request help 
        <span
          aria-hidden="true"
        >
          →
        </span>
      </a>
    </p>
  </div>
  <div
    className="g g--mr emotion-20"
  >
    <div
      className="t--info g--6 m-b500"
    >
      <button
        className="lnk emotion-19"
        onClick={[Function]}
        type="button"
      >
        <span
          style={
            Object {
              "fontStyle": "italic",
              "whiteSpace": "nowrap",
            }
          }
        >
          <span
            aria-hidden="true"
            style={
              Object {
                "fontStyle": "normal",
              }
            }
          >
            ←
          </span>
           
          Back
        </span>
      </button>
    </div>
    <div
      className="g--6 ta-r m-b500"
    >
      <button
        className="btn btn--b-sm"
        disabled={true}
        onClick={[Function]}
        type="button"
      >
        Review request
      </button>
    </div>
  </div>
</div>
`;

