              </a>
              <span
                aria-hidden="true"
                className="brc-s"
                style={
                  Object {
                    "cursor": "default",
                  }
                }
              >
                 
                ›
                 
              </span>
            </li>
            <li
              className="brc-l-i"
            >
              <a
                aria-current="page"
