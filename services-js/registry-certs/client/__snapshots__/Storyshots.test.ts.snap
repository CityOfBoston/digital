      <div
        className="a11y--content-start"
        id="content-start"
      />
      <main
        className="b-ff"
      >
        <div>
          <div
            className="b-c b-c--nbp emotion-40"
          >
            <h1
              className="emotion-5"
            >
              Request a death certificate
            </h1>
            <div
              className="emotion-7"
            >
              <div
                className="emotion-6"
              >
                <progress
                  aria-valuemax={7}
                  aria-valuemin={1}
                  aria-valuenow={1}
                  aria-valuetext="Step 1 of 7"
                  max={7}
                  value={1}
                >
                  Step 1 of 7
                </progress>
                <span
                  aria-hidden="true"
                >
                  Step 1 of 7
                </span>
              </div>
            </div>
            <form
              acceptCharset="UTF-8"
              action="/death"
              className="emotion-13"
              method="get"
              onSubmit={[Function]}
            >
              <input
                name="utf8"
                type="hidden"
                value="✓"
              />
              <label
                className="emotion-8"
                htmlFor="death-search-q"
              >
                Search by full name or partial name
              </label>
              <div
                className="emotion-12"
              >
                <button
                  aria-label="Search"
                  className="emotion-9"
                  type="submit"
                >
                  <img
                    alt=""
                    height={24}
                    src="/assets/images/death-search-icon.svg"
                    width={24}
                  />
                </button>
                <input
                  aria-label="Search by full name or partial name"
                  autoComplete="off"
                  className="emotion-10"
                  id="death-search-q"
                  name="q"
                  onChange={[Function]}
                  placeholder="Search by full name or partial name"
                  type="text"
                  value="Jayn Doe"
                />
                <button
                  aria-label="Clear search"
                  className="emotion-9"
                  onClick={[Function]}
                  type="button"
                >
                  <img
                    alt=""
                    height={24}
                    src="/assets/images/death-search-clear.svg"
                    width={24}
                  />
                </button>
              </div>
            </form>
            <div
              className="emotion-39"
            >
              <p
                className="emotion-14"
              >
                Select the correct person from the results below. If multiple people have similar names, check the date of birth and date of death carefully before continuing, this can’t be changed once your order is submitted.
              </p>
              <div
                className="emotion-15"
              >
                Showing 
                1
                –
                3
                 of 
                3
                 
                results for “
                Jayn Doe
                ”
              </div>
              <div
                className="emotion-38"
              >
