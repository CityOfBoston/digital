      <main
        className="b-ff"
      >
        <div
          className="b-c   emotion-8"
        >
          <h1
            className="emotion-2"
          >
            Request a death certificate
          </h1>
          <div
            className="emotion-4"
          >
            <div
              className="emotion-3"
            >
              <progress
                aria-valuemax={7}
                aria-valuemin={1}
                aria-valuenow={6}
                aria-valuetext="Step 6 of 7"
                max={7}
                value={6}
              >
                Step 6 of 7
              </progress>
              <span
                aria-hidden="true"
              >
                Step 6 of 7
              </span>
            </div>
          </div>
          <h2
            className="emotion-5"
          >
            Payment
          </h2>
          <div
            className="m-v300"
          >
            <div
              className="emotion-6"
            >
              <button
                aria-expanded={false}
                className="drawerHeader "
                onClick={[Function]}
                type="button"
              >
                Your order details
                <div
                  className="arrow"
                />
              </button>
              <div
                className="body"
              >
                <div
                  role="region"
                />
              </div>
            </div>
          </div>
          <form
            acceptCharset="UTF-8"
            className="emotion-7"
            method="post"
            onSubmit={[Function]}
          >
            <div
              className="row info-row"
            >
              <div
                className="col"
              >
                <label
                  className="header"
