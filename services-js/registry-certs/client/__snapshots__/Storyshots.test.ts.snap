                  <div
                    className="emotion-267"
                  >
                    <h1
                      className="emotion-5"
                    >
                      Marriage
                      <div
                        className="notice"
                      />
                    </h1>
                    <span />
                    <div
                      className="emotion-9"
                    >
                      <div
                        className="emotion-8"
                      >
                        <div
                          aria-labelledby="partnerB_bloodRelation-groupLabel"
                          className="radio-group__label"
                          role="group"
                        >
                          <div
                            className="txt-l"
                            id="partnerB_bloodRelation-groupLabel"
                            style={
                              Object {
                                "display": "flex",
                              }
                            }
                          >
                            Are you related by blood or marriage to your future spouse?
                            <span
                              className="t--req"
                              style={
                                Object {
                                  "display": "flex",
                                  "paddingLeft": "0.25em",
                                }
                              }
                            >
                              Required
                            </span>
                            <div
                              className="emotion-7"
                            >
                              <div
                                className="icon"
                              />
                              <div
                                className="msg"
                              >
                                This information is collected to ensure the marriage abides by Massachusetts State Law Chapter 207 Sections 1-8.
                              </div>
                            </div>
                          </div>
                          <label
                            className="ra  "
                          >
                            <input
                              className="ra-f"
                              name="partnerB_bloodRelation"
                              onChange={[Function]}
                              type="radio"
                              value="1"
                            />
                            <span
                              className="ra-l"
                            >
                              Yes
                            </span>
                          </label>
                          <label
                            className="ra  "
                          >
                            <input
                              className="ra-f"
                              name="partnerB_bloodRelation"
                              onChange={[Function]}
                              type="radio"
                              value="0"
                            />
                            <span
