    margin-left: auto;
  }

  .emotion-7 .lnk {
    padding-left: 0;
  }
}

.emotion-4 {
  padding-bottom: 0.25rem;
  margin-bottom: 0;
  font-family: Montserrat,Arial,sans-serif;
  font-weight: 700;
  font-size: 1.5rem;
  color: #091f2f;
  text-transform: uppercase;
}

.emotion-4.secondary {
  margin-bottom: 1rem;
  font-size: 1.25rem;
  border-width: 3px;
}

.emotion-4.secondary em {
  font-size: 1rem;
}

.emotion-6 {
  padding: 1.25rem !important;
  padding-left: 0 !important;
}

