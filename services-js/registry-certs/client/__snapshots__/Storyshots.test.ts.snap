                          y2="22.629"
                        />
                        <line
                          x2="22.629"
                          y1="22.629"
                        />
                      </g>
                    </svg>
                    <input
                      checked={false}
                      name="filedInBoston"
                      onChange={[Function]}
                      type="radio"
                      value="no"
                    />
                    <span>
                      No
                    </span>
                  </label>
                </div>
              </fieldset>
            </div>
            <div
              className="g g--mr emotion-15"
            >
              <div
                className="t--info g--6 m-b500"
              >
                <button
                  className="lnk emotion-14"
