                  </div>
                </div>
                <div
                  className="row"
                >
                  <div
                    className="col"
                  >
                    <label
                      className="header"
                    >
                      Order Details
                    </label>
                  </div>
                  <div
                    className="col"
                  >
                    <a
                      aria-label="Edit contact information"
                      className="btn"
                      href="/marriage/review"
                      onClick={[Function]}
                      onMouseEnter={[Function]}
                    >
                      edit
                    </a>
                  </div>
                </div>
                <div
                  className="certRow"
                >
                  <div>
                    <div
                      className="emotion-3"
                    >
