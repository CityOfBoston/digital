                  </div>
                  <div>
                    New York
                    , 
                    NY
                     
                    12223
                  </div>
                </div>
                <div
                  className="col"
                >
                  <a
                    aria-label="Edit contact information"
                    className="btn"
                    href="/death/checkout?page=payment"
                    onClick={[Function]}
                    onMouseEnter={[Function]}
                  >
                    edit
                  </a>
                </div>
              </div>
              <div
                className="row info-row"
              >
                <div
                  className="col"
                >
                  <label
                    className="header"
                  >
                    Order Details
                  </label>
                  <div
                    className="death-order-items"
                  />
                </div>
                <div
                  className="col"
                >
                  <a
                    aria-label="Edit contact information"
                    className="btn"
                    href="/death/cart"
                    onClick={[Function]}
                    onMouseEnter={[Function]}
                  >
                    edit
                  </a>
                </div>
              </div>
              <div
                className="m-v500"
              >
                <h1
                  className="summary"
                >
                  Order Summary
                </h1>
                <div
                  className="emotion-6"
                >
                  <div
                    className="row"
                  >
                    <div
                      className="col"
                    >
                      Subtotal: 0 certificates × $14.00
                    </div>
                    <div
                      className="col"
                    >
                      $
                      0.00
                    </div>
                  </div>
                  
                  <div
                    className="row"
                  >
                    <div
                      className="col"
                    >
                      US Shipping
                    </div>
                    <div
                      className="col"
                    >
                      FREE
                    </div>
                  </div>
                  <div
                    className="row"
                  >
                    <div
                      className="col"
                    >
