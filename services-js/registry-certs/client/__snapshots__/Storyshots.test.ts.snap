                    </label>
                    <div>
                      Nancy Whitehead
                    </div>
                    <div>
                      •••• •••• •••• 
                      4040
                    </div>
                    <div>
                      3 Avengers Towers
                    </div>
                    <div>
                      New York
                      , 
                      NY
                       
                      12223
                    </div>
                  </div>
                  <div
                    className="col"
                  >
