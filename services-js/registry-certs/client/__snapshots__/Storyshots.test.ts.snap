              </a>
            </li>
          </ul>
        </nav>
      </div>
      <div
        className="a11y--content-start"
        id="content-start"
      />
      <main
        className="b-ff"
      >
        <div
          className="b-c b-c--nbp  emotion-9"
        >
          <h1
            className="emotion-2"
          >
            Request a death certificate
          </h1>
          <div
            className="emotion-4"
          >
            <div
              className="emotion-3"
            >
              <progress
                aria-valuemax={7}
                aria-valuemin={1}
                aria-valuenow={7}
                aria-valuetext="Step 7 of 7"
                max={7}
                value={7}
              >
                Step 7 of 7
              </progress>
              <span
                aria-hidden="true"
              >
                Step 7 of 7
              </span>
            </div>
          </div>
          <h2
            className="emotion-5"
          >
            Review order
          </h2>
          <div
            className="emotion-8"
          >
            <div
              className="t--info m-v500"
            >
              Your order is not yet complete. Please check the information below, then click the 
              <b>
                Submit Order
              </b>
               button.
            </div>
            <form
              acceptCharset="UTF-8"
              method="post"
              onSubmit={[Function]}
            >
              <div
                className="row info-row"
              >
                <div
                  className="col"
                >
                  <label
                    className="header"
                  >
                    Contact Information
                  </label>
                  <div
                    className="info"
                  >
                    squirrel.girl@avengers.org
                  </div>
                  <div
                    className="info"
                  >
                    (555) 123-9999
                  </div>
                </div>
                <div
                  className="col"
                >
                  <a
                    aria-label="Edit contact information"
                    className="btn"
                    href="/death/checkout?page=shipping"
                    onClick={[Function]}
                    onMouseEnter={[Function]}
                  >
                    edit
                  </a>
                </div>
              </div>
              <div
                className="row info-row"
              >
                <div
                  className="col"
                >
                  <label
                    className="header"
                  >
                    Shipping Address
                  </label>
                  <div>
                    Doreen Green
                  </div>
                  <div>
                    Empire State University
                  </div>
                  <div>
                    Dorm Hall, Apt 5
                  </div>
                  <div>
                    10 College Avenue
                  </div>
                  <div>
                    New York, NY 12345
                  </div>
                </div>
                <div
                  className="col"
                >
                  <a
                    aria-label="Edit contact information"
                    className="btn"
                    href="/death/checkout?page=shipping"
                    onClick={[Function]}
                    onMouseEnter={[Function]}
                  >
                    edit
                  </a>
                </div>
              </div>
              <div
                className="row info-row"
              >
                <div
                  className="col"
                >
                  <label
                    className="header"
                  >
                    Payment Information
                  </label>
                  <div>
                    Nancy Whitehead
                  </div>
                  <div>
                    •••• •••• •••• 
                    4040
                  </div>
                  <div>
                    3 Avengers Towers
                  </div>
                  <div>
                    New York
                    , 
                    NY
                     
                    12223
                  </div>
                </div>
                <div
                  className="col"
                >
                  <a
                    aria-label="Edit contact information"
                    className="btn"
                    href="/death/checkout?page=payment"
                    onClick={[Function]}
                    onMouseEnter={[Function]}
                  >
                    edit
                  </a>
                </div>
              </div>
              <div
                className="row info-row"
              >
                <div
                  className="col"
                >
                  <label
                    className="header"
                  >
                    Order Details
                  </label>
                  <div
                    className="death-order-items"
                  >
                    <div
                      className="death-order-item"
                    >
                      <p>
                        <span
                          className="death-order-item-label"
                        >
                          Name: 
                        </span>
                        BRUCE
                         
                        BANNER
                      </p>
                      <p>
                        <span
                          className="death-order-item-label"
                        >
                          SS Included: 
                        </span>
                        No
                      </p>
                      <p>
                        <span
                          className="death-order-item-label"
                        >
                          Quantity: 
                        </span>
                        1
                      </p>
                    </div>
                    <div
                      className="death-order-item"
                    >
                      <p>
                        <span
                          className="death-order-item-label"
                        >
                          Name: 
                        </span>
                        MONKEY
                         
                        JOE
                      </p>
                      <p>
                        <span
                          className="death-order-item-label"
                        >
                          SS Included: 
                        </span>
                        No
                      </p>
                      <p>
                        <span
                          className="death-order-item-label"
                        >
                          Quantity: 
                        </span>
                        5
                      </p>
                    </div>
                  </div>
                </div>
                <div
                  className="col"
                >
                  <a
                    aria-label="Edit contact information"
                    className="btn"
                    href="/death/cart"
                    onClick={[Function]}
                    onMouseEnter={[Function]}
                  >
                    edit
                  </a>
                </div>
              </div>
              <div
                className="m-v500"
              >
                <h1
                  className="summary"
                >
                  Order Summary
                </h1>
                <div
                  className="emotion-6"
                >
                  <div
                    className="row"
                  >
                    <div
                      className="col"
                    >
                      Subtotal: 6 certificates × $14.00
                    </div>
                    <div
                      className="col"
                    >
                      $
                      84.00
                    </div>
                  </div>
                  
                  <div
                    className="row"
                  >
                    <div
                      className="col"
                    >
                      US Shipping
                    </div>
                    <div
                      className="col"
                    >
                      FREE
                    </div>
                  </div>
                  <div
                    className="row"
                  >
                    <div
                      className="col"
                    >
                      USPS Tracking®
                    </div>
                    <div
                      className="col"
                    >
                      $ 5.00
                    </div>
                  </div>
                  <div
                    className="row"
                  >
                    <div
                      className="col"
                    >
                      Service fee
                    </div>
                    <div
                      className="col"
                    >
                      $ 
                      2.16
                    </div>
                  </div>
                  <div
                    className="row"
                  >
                    <div
                      className="col"
                    >
                      Total
                    </div>
                    <div
                      className="col total-cost"
                    >
                      $ 
                      91.16
                    </div>
                  </div>
                </div>
              </div>
              <fieldset
                aria-labelledby="review-accept-heading"
                className="m-v700 death-accept-fieldset"
              >
                <legend
                  className="t--info death-accept-legend"
                  id="review-accept-heading"
                >
                  Please read and accept before placing your order.
                </legend>
                <div
                  className="death-accept-box m-v300"
                >
                  <label
                    className="cb death-accept-label"
                    htmlFor="acceptNonRefundableInput"
                  >
                    <input
                      aria-required="true"
                      checked={false}
                      className="cb-f death-accept-checkbox"
                      id="acceptNonRefundableInput"
                      name="acceptNonRefundable"
                      onChange={[Function]}
                      type="checkbox"
                      value="true"
                    />
                    <span
                      className="cb-l death-accept-text"
                    >
                      I understand that certificate fees are non-refundable once my order is submitted.
                    </span>
                  </label>
                </div>
              </fieldset>
              <div
                className="t--info m-v300 death-charge-note"
                id="charge-message"
              >
                <strong>
                  Note:
                </strong>
                 Selecting 
                <strong>
                  Submit Order
                </strong>
                 
                will place a temporary authorization hold on your payment card. Your order will be reviewed by the Registry, and your card will be charged only if your order is approved.
              </div>
              <div
                className="md"
              >
                <div
                  className="md-c br br-t400 emotion-7"
                >
                  <div
                    className="md-b p-a300"
                  >
                    <div
                      className="t--intro t--err"
                    >
                      There’s a problem: The order could not be processed.
                    </div>
                    <div
                      className="t--info m-t300"
                    >
                      You can try again. If this keeps happening, please email
                       
                      <a
                        href="mailto:digital@boston.gov"
                      >
                        digital@boston.gov
                      </a>
                      .
                    </div>
                    <div
                      className="m-t300 ta-r"
                    >
                      <button
                        autoFocus={true}
                        className="btn btn--sm btn--100"
                        onClick={[Function]}
                        type="button"
                      >
                        Close
                      </button>
                    </div>
                  </div>
                </div>
              </div>
              <div
                className="m-v300"
              >
                <button
                  aria-describedby="charge-message"
                  className="btn"
                  disabled={true}
                  style={
                    Object {
                      "display": "block",
                      "width": "100%",
                    }
                  }
                  type="submit"
                >
                  Submit Order
                </button>
              </div>
              <div
                className="ta-c t--info m-v700"
              >
                <a
                  href="/death"
                  onClick={[Function]}
                  onMouseEnter={[Function]}
                >
                  I’m not done yet, go back to search
                </a>
              </div>
            </form>
          </div>
        </div>
        <div
          className="b--g m-t700"
        >
          <div
            className="b-c b-c--smv b-c--hsm t--subinfo"
            id="service-fee"
          >
            * You are charged an extra service fee of not more than
             
            $0.25
             plus 
            2.15%
            . This fee goes directly to a third party to pay for the cost of credit card processing. Learn more about
             
            <a
              href="https://www.boston.gov/common-questions-about-online-payments"
            >
              credit card service fees
            </a>
             at the City of Boston.
          </div>
        </div>
      </main>
    </div>
  </div>,
  <footer
    className="ft"
    dangerouslySetInnerHTML={
      Object {
        "__html": "
<div class=\\"ft-c ft-ite\\">
  <ul class=\\"ft-ll ft-ite-links\\">
