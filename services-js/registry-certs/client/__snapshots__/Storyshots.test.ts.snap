          </h1>
          <div
            className="emotion-3"
          >
            <div
              className="progressbar"
            >
              <div
                className="nav"
              >
                <a
                  aria-label="Getting Started"
                  className="completed focused current"
                  onClick={[Function]}
                  title="Getting Started"
                >
                  Getting Started
                  <span
                    className="arrow"
