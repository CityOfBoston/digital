}

.emotion-8 .row .btn:hover {
  background: #1871bd;
  color: #fff;
}

.emotion-8 .info-row {
  margin-bottom: 3rem;
  padding-bottom: 3rem;
  border-bottom: 1px solid #d2d2d2;
}

.emotion-8 .info-row .col:first-of-type {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-flex-direction: column;
  -ms-flex-direction: column;
  flex-direction: column;
  gap: 12px;
  -webkit-flex: 1;
  -ms-flex: 1;
  flex: 1;
  min-width: 0;
  font-family: Lora,Georgia,serif;
  font-size: 1.125rem;
  line-height: 1.3;
  color: #091f2f;
}

.emotion-8 .info-row .info {
  margin-bottom: 0;
}

.emotion-8 .row label.header {
  margin: 0;
  font-size: 24px;
  line-height: normal;
}

.emotion-8 .death-order-items {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-flex-direction: column;
  -ms-flex-direction: column;
  flex-direction: column;
  gap: 0;
  width: 100%;
}

.emotion-8 .death-order-item {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-flex-direction: column;
  -ms-flex-direction: column;
  flex-direction: column;
  gap: 12px;
  padding: 1.5rem 0;
  border-bottom: 1px solid #d2d2d2;
  font-family: inherit;
  font-size: inherit;
  line-height: inherit;
  color: inherit;
}

.emotion-8 .death-order-item p {
  margin: 0;
}

.emotion-8 .death-order-item:first-of-type {
  padding-top: 0;
}

.emotion-8 .death-order-item:last-of-type {
  border-bottom: none;
  padding-bottom: 0;
}

.emotion-8 .death-order-item-label {
  font-weight: 700;
}

.emotion-8 .death-accept-box {
  box-sizing: border-box;
  width: 100%;
  border: 1px solid #d2d2d2;
  padding: 0;
  background: #fff;
  -webkit-transition: background-color 0.15s ease,border-color 0.15s ease;
  transition: background-color 0.15s ease,border-color 0.15s ease;
}

.emotion-8 .death-accept-box:hover {
  background: #f2f2f2;
  border-color: #1871bd;
  cursor: pointer;
}

.emotion-8 .death-accept-box:active {
  background: #e8e8e8;
}

.emotion-8 .death-accept-box:focus-within {
  outline: 2px solid #1871bd;
  outline-offset: 2px;
}

.emotion-8 .death-accept-fieldset {
  border: 0;
  margin: 2.5rem 0;
  padding: 0;
  min-width: 0;
}

.emotion-8 .death-accept-legend {
  display: block;
  padding: 0;
  float: none;
  width: 100%;
}

.emotion-8 .death-accept-label.cb {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-align-items: center;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
  gap: 0;
  margin: 0;
  padding: 10px;
  width: 100%;
  min-height: 100%;
  box-sizing: border-box;
  cursor: pointer;
}

.emotion-8 .death-accept-checkbox.cb-f {
  position: relative;
  -webkit-flex-shrink: 0;
  -ms-flex-negative: 0;
  flex-shrink: 0;
  -webkit-align-self: center;
  -ms-flex-item-align: center;
  align-self: center;
  width: 22px;
  height: 22px;
  margin: 0 12px 0 0;
  padding: 0;
  -webkit-transform: none;
  -ms-transform: none;
  transform: none;
}

.emotion-8 .death-accept-checkbox.cb-f:before {
  position: absolute;
  top: 0;
  left: 0;
  width: 22px;
  height: 22px;
  border-width: 2px;
  background-size: 70% !important;
}

.emotion-8 .death-accept-text.cb-l {
  -webkit-flex: 1;
  -ms-flex: 1;
  flex: 1;
  min-width: 0;
  width: auto;
