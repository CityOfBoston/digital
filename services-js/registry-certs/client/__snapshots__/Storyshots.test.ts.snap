.emotion-11 {
  width: 80px;
  height: 80px;
}

.emotion-11 ellipse {
  stroke: currentColor;
  stroke-width: 5;
  fill: #fff;
}

.emotion-11.checkMark,
.emotion-11.xSymbol {
  fill: none;
  stroke-width: 7;
  stroke-linecap: round;
}

.emotion-11.checkMark {
  stroke: #62A744;
}

.emotion-11.xSymbol {
  stroke: #f04f46;
}

.emotion-11.questionMark path {
  fill: #091f2f;
  stroke: none;
}

.emotion-8 {
  border: none;
  background-color: transparent;
  padding: 0;
  font-family: inherit;
  font-size: inherit;
