                  <span
                    aria-hidden={true}
                    className="t--req"
                  >
                    Required
                  </span>
                </label>
                <input
                  aria-required="true"
                  autoComplete="email"
                  className="txt-f txt-f--100 "
                  id="contactEmail"
                  name="contactEmail"
                  onBlur={[Function]}
                  onChange={[Function]}
                  placeholder="Email address"
                  type="email"
                  value="notacompleteaddress@"
                />
              </div>
              <div
                className="txt"
              >
                <label
                  className="txt-l txt-l--sm"
                  htmlFor="confirmContactEmail"
                >
                  Confirm Email Address
                   
                  <span
                    aria-hidden={true}
                    className="t--req"
                  >
                    Required
                  </span>
                </label>
                <input
                  aria-required="true"
                  autoComplete="email"
                  className="txt-f txt-f--100 "
                  id="confirmContactEmail"
                  name="confirmContactEmail"
                  onBlur={[Function]}
                  onChange={[Function]}
                  placeholder="Email address"
                  type="email"
                  value="squirrel.girl@avengers.org"
                />
              </div>
              <div
                className="txt"
              >
                <label
                  className="txt-l txt-l--sm"
                  htmlFor="contactPhone"
