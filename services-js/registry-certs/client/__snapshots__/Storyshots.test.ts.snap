.emotion-0 .body .notes {
  padding-bottom: 1.115rem;
  font-style: normal;
}

.emotion-0 .drawerHeader[aria-expanded='true'] + .body {
  padding: 24px;
}

.emotion-0 .drawerHeader[aria-expanded='true'] + .body .order_items--death {
  margin-bottom: 2rem;
}

.emotion-0 .drawerHeader[aria-expanded='true'] + .body .cost_summary {
  padding-bottom: 2rem;
}

.emotion-0 .drawerHeader[aria-expanded='true'] + .body .notes {
  padding-bottom: 0;
}

<div
