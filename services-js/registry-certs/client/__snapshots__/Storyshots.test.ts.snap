                        >
                          Name: 
                        </span>
                        BRUCE
                         
                        BANNER
                      </p>
                      <p>
                        <span
                          className="death-order-item-label"
                        >
                          SS Included: 
                        </span>
                        No
                      </p>
                      <p>
                        <span
                          className="death-order-item-label"
                        >
                          Quantity: 
                        </span>
                        1
                      </p>
                    </div>
                    <div
                      className="death-order-item"
                    >
                      <p>
                        <span
                          className="death-order-item-label"
                        >
