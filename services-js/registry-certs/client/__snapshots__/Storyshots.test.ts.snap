                      onChange={[Function]}
                      type="checkbox"
                      value="true"
                    />
                    <span
                      className="cb-l death-accept-text"
                    >
                      I understand that this order has
                       
                      <strong>
                        pending death certificates
                      </strong>
                      , which may not be accepted by insurance or banking companies.
                    </span>
                  </label>
                </div>
              </fieldset>
              <div
                className="t--info m-v300 death-charge-note"
                id="charge-message"
              >
                <strong>
                  Note:
                </strong>
                 Selecting 
                <strong>
                  Submit Order
                </strong>
                 
                will place a temporary authorization hold on your payment card. Your order will be reviewed by the Registry, and your card will be charged only if your order is approved.
              </div>
              <div
                className="m-v300"
              >
                <button
                  aria-describedby="charge-message"
                  className="btn"
                  disabled={true}
                  style={
                    Object {
                      "display": "block",
                      "width": "100%",
                    }
                  }
                  type="submit"
                >
                  Submit Order
                </button>
              </div>
              <div
                className="ta-c t--info m-v700"
              >
                <a
                  href="/death"
                  onClick={[Function]}
                  onMouseEnter={[Function]}
                >
                  I’m not done yet, go back to search
                </a>
              </div>
            </form>
          </div>
        </div>
        <div
          className="b--g m-t700"
        >
          <div
            className="b-c b-c--smv b-c--hsm t--subinfo"
