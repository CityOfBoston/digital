  .emotion-1 {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.emotion-0 {
  color: #d22d23;
}

.emotion-3 progress {
  margin: 1rem 0 0.25rem;
  width: 100%;
  height: 1rem;
  border: 2px solid #091f2f;
  background-color: #fff;
}

.emotion-3 progress::-webkit-progress-bar {
  background-color: #fff;
}

.emotion-3 progress::-webkit-progress-value {
  -webkit-transition: width 0.5s;
  transition: width 0.5s;
  background-color: #288be4;
}

.emotion-3 progress::-moz-progress-bar {
  background-color: #288be4;
}

.emotion-3 progress::-ms-fill {
  background-color: #288be4;
}

.emotion-3 span {
  font-style: italic;
}

.emotion-5 fieldset + fieldset {
  margin-top: 2rem;
}

@media screen and (min-width:480px) {
  .emotion-5 fieldset + fieldset {
    margin-top: 4rem;
  }

  .emotion-5 fieldset + fieldset .lnk {
    padding-left: 0;
  }
}

.emotion-7 {
  text-align: center;
}

@media screen and (min-width:480px) {
  .emotion-7 {
    margin-top: 2.5rem;
    text-align: left;
  }

  .emotion-7 > div {
    display: -webkit-box;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
  }

  .emotion-7 > div.ta-r > button {
    margin-left: auto;
  }

  .emotion-7 .lnk {
    padding-left: 0;
  }
}

.emotion-4 {
  padding-bottom: 0.25rem;
  margin-bottom: 0;
  font-family: Montserrat,Arial,sans-serif;
  font-weight: 700;
  font-size: 1.5rem;
  color: #091f2f;
  text-transform: uppercase;
}

.emotion-4.secondary {
  margin-bottom: 1rem;
  font-size: 1.25rem;
  border-width: 3px;
}

.emotion-4.secondary em {
  font-size: 1rem;
}

.emotion-6 {
  padding: 1.25rem !important;
  padding-left: 0 !important;
}

.emotion-2 {
  padding-right: 0;
}

@media screen and (min-width:980px) {
  .emotion-2 {
    font-size: 34px;
  }
}

